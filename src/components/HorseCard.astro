---
import Icon from "./Icon.astro";
import { statutLabel, horseAge } from "../data/chevaux";

interface Props {
  entry: any;
}
const { entry } = Astro.props;
const d = entry.data;
const photo = d.photos[0];
const age = horseAge(d.annee);
const facts = [
  age && `${age} ans`,
  d.sexe && d.sexe.charAt(0).toUpperCase() + d.sexe.slice(1),
  d.robe,
  d.montable ? "Montable" : "Non montable",
].filter(Boolean);
---

<article class:list={["hc", d.placed && "hc--placed"]}>
  <a href={`/adopter/${entry.id}`}>
    <div class="hc__media">
      {
        photo ? (
          <img src={photo.src} alt={photo.alt} loading="lazy" />
        ) : (
          <div class="hc__noimg" aria-hidden="true">
            <Icon name="horse" />
          </div>
        )
      }
      <span class:list={["hc__tag", `hc__tag--${d.statut}`]}>
        {statutLabel[d.statut]}
      </span>
      {d.placed && <span class="hc__placed">Placé</span>}
    </div>

    <div class="hc__body">
      <h3>{d.nom}</h3>
      {facts.length > 0 && <p class="hc__facts">{facts.join(" · ")}</p>}
      <p class="hc__resume">{d.resume}</p>
      <p class="hc__where">
        {d.structure ?? "Placement direct"}
        {d.departement && <span> — {d.departement}</span>}
      </p>
      <span class="tlink">
        Voir la fiche
        <Icon name="arrow" />
      </span>
    </div>
  </a>
</article>

<style>
  .hc {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .hc:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 50px -30px rgba(35, 35, 31, 0.5);
  }
  .hc--placed {
    opacity: 0.72;
  }
  .hc > a {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .hc__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--cream-warm);
  }
  .hc__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hc__noimg {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--line-strong);
  }
  .hc__noimg :global(svg) {
    width: 46px;
    height: 46px;
  }

  .hc__tag {
    position: absolute;
    left: 0.9rem;
    top: 0.9rem;
    padding: 0.34rem 0.7rem;
    border-radius: 999px;
    background: var(--forest);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .hc__tag--adoption {
    background: var(--moss);
  }
  .hc__tag--adoption-directe {
    background: var(--ink);
  }
  .hc__placed {
    position: absolute;
    right: 0.9rem;
    top: 0.9rem;
    padding: 0.34rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .hc__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem 1.5rem 1.6rem;
  }
  .hc__body h3 {
    font-size: 1.4rem;
  }
  .hc__facts {
    margin: 0;
    color: var(--moss);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hc__resume {
    margin: 0.3rem 0 0;
    flex: 1;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .hc__where {
    margin: 0;
    color: var(--ink-faint);
    font-size: 0.82rem;
  }
</style>
