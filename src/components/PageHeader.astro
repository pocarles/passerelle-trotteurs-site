---
interface Props {
  eyebrow: string;
  title: string;
  /** Rendered in italic moss after the title — the design's accent clause. */
  accent?: string;
  lead?: string;
  image?: string;
  imageAlt?: string;
  background?: boolean;
}
const { eyebrow, title, accent, lead, image, imageAlt = "", background = false } = Astro.props;
---

<header
  class:list={["ph", image && !background && "ph--split", background && "ph--background"]}
>
  {background && image && <img class="ph__bg" src={image} alt="" aria-hidden="true" loading="eager" />}
  <div class="wrap ph__in">
    <div class="ph__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>
        {title}
        {accent && <><br /><span class="accent">{accent}</span></>}
      </h1>
      <hr class="rule" />
      {lead && <p class="lead">{lead}</p>}
    </div>
    {
      image && !background && (
        <figure class="ph__fig">
          <img src={image} alt={imageAlt} loading="eager" />
        </figure>
      )
    }
  </div>
</header>

<style>
  .ph {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }
  .ph--background {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    background: var(--forest-deep);
  }
  .ph--background::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(11, 35, 22, 0.86), rgba(11, 35, 22, 0.48));
  }
  .ph--background .ph__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .ph--background .ph__in {
    position: relative;
    z-index: 2;
    grid-template-columns: 1fr;
  }
  .ph--background .ph__copy {
    max-width: 58ch;
  }
  .ph--background .eyebrow {
    color: var(--sage);
  }
  .ph--background h1 {
    color: #fff;
  }
  .ph--background .accent {
    color: var(--sage);
  }
  .ph--background .rule {
    background: var(--sage);
  }
  .ph--background .lead {
    color: rgba(255, 255, 255, 0.86);
  }
  .ph__in {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .ph--split .ph__in {
    grid-template-columns: 1fr 0.85fr;
  }
  .ph h1 {
    font-size: clamp(2.4rem, 4.6vw, 3.9rem);
  }
  .ph .lead {
    margin: 0;
  }
  .ph__fig {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 5 / 4;
  }
  .ph__fig img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .ph--split .ph__in {
      grid-template-columns: 1fr;
    }
    .ph__fig {
      aspect-ratio: 16 / 10;
    }
  }
</style>
