---
import Icon from "./Icon.astro";

interface Props {
  text: string;
  accent?: string;
  label: string;
  href: string;
  external?: boolean;
  note?: string;
  icon?: string;
  className?: string;
}
const {
  text,
  accent,
  label,
  href,
  external = false,
  note,
  icon = "heart",
  className,
} = Astro.props;
---

<section class={`cta-sec ${className ?? ""}`}>
  <div class="wrap">
    <div class="cta">
      <span class="badge cta__badge"><Icon name={icon} /></span>
      <p class="cta__text">
        {text}{accent && <> <span class="accent">{accent}</span></>}
      </p>
      <a
        class="btn btn--primary"
        href={href}
        target={external ? "_blank" : undefined}
        rel={external ? "noreferrer" : undefined}
      >
        {label}
        <span class="btn__ico"><Icon name="arrow" /></span>
      </a>
    </div>
    {note && <p class="cta__note">{note}</p>}
  </div>
</section>

<style>
  .cta-sec {
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }
  .cta-sec--racecare {
    padding-top: clamp(2.75rem, 5vw, 4.5rem);
  }
  .cta {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 3vw, 2.5rem);
    padding: clamp(1.4rem, 2.5vw, 1.8rem) clamp(1.4rem, 2.5vw, 2rem);
    background: var(--cream-warm);
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .cta__badge {
    background: var(--sage);
    color: var(--forest-deep);
  }
  .cta__text {
    flex: 1;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .cta .btn {
    flex: 0 0 auto;
  }
  .cta__note {
    margin: 1.2rem auto 0;
    text-align: center;
    color: var(--ink-faint);
    font-size: 0.85rem;
  }

  @media (max-width: 720px) {
    .cta {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.2rem;
      border-radius: var(--radius-lg);
    }
  }
</style>
