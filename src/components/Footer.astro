---
import { site, links } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="ftr">
  <section class="ftr__newsletter" aria-labelledby="newsletter-title">
    <div class="ftr__newsletter-copy">
      <span class="ftr__eyebrow">Newsletter</span>
      <h2 id="newsletter-title">Recevez les nouvelles de Passerelle.</h2>
      <p>Inscrivez-vous pour suivre nos actions et les actualités de la reconversion.</p>
    </div>
    <iframe
      title="Inscription à la newsletter Passerelle"
      src="https://b778a3ac.sibforms.com/v2/serve/MUIFAEpeO5DaBYIsuYto-dvKzhLslfhP3Zv3rWM5BvUG6oqUWNHPOS2oZGe5HqklP3QO48oiSuX7gWSI6nIROynZ07O5mwF-COe7VqPOVbGt1v4VjCpvTCSDYfAS6rpRTrS17-zPESN1bZAliptbmdNFlhnwd8PWdmTr9RuThtZ1Ho7Hhwt1oC0LE0F5-slOHmRG0YdyWk9biwh1Tg=="
      frameborder="0"
      scrolling="auto"
      loading="lazy"
    ></iframe>
  </section>

  <div class="ftr__in">
    <div class="ftr__brand">
      <img src="/media/logo.png" alt="Passerelle" width="1472" height="869" />
      <p>
        Association loi 1901 reconnue d’intérêt général. Du cheval de courses de
        Trot au cheval de sport et de loisir.
      </p>
      <div class="ftr__social">
        <a href={links.facebook} target="_blank" rel="noreferrer">Facebook</a>
        <a href={links.instagram} target="_blank" rel="noreferrer">Instagram</a>
      </div>
    </div>

    <div>
      <h2>Participer</h2>
      <a href="/adopter">Adopter un trotteur</a>
      <a href={links.donate} target="_blank" rel="noreferrer">Faire un don</a>
      <a href={links.join} target="_blank" rel="noreferrer">Devenir membre</a>
      <a href={links.sponsor} target="_blank" rel="noreferrer">Parrainer un trotteur</a>
    </div>

    <div>
      <h2>L’association</h2>
      <a href="/association">À propos</a>
      <a href="/association/equipe">L’équipe</a>
      <a href="/reseau">Le réseau accrédité</a>
      <a href="/mecenes">Mécènes & ambassadeurs</a>
      <a href="/actualites">Actualités</a>
    </div>

    <div>
      <h2>Contact</h2>
      <p class="ftr__addr">
        {site.address.street}<br />
        {site.address.postalCode} {site.address.city}, {site.address.country}
      </p>
      <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>

  <div class="ftr__base">
    <span>© {year} {site.fullName}</span>
    <nav aria-label="Liens légaux">
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/confidentialite">Confidentialité</a>
    </nav>
  </div>
</footer>

<style>
  .ftr {
    background: var(--forest-deep);
    color: rgba(255, 255, 255, 0.72);
    padding: clamp(3.5rem, 7vw, 6rem) 0 2rem;
  }
  .ftr__newsletter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 540px);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    max-width: var(--maxw);
    margin: 0 auto clamp(3.5rem, 7vw, 6rem);
    padding: 0 var(--gutter) clamp(3.5rem, 7vw, 6rem);
    border-bottom: 1px solid var(--line-light);
  }
  .ftr__newsletter-copy {
    max-width: 36rem;
  }
  .ftr__eyebrow {
    display: block;
    margin-bottom: 1rem;
    color: var(--sage);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .ftr__newsletter h2 {
    margin: 0 0 1rem;
    color: #fff;
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-transform: none;
  }
  .ftr__newsletter p {
    max-width: 34ch;
    margin: 0;
    font-size: 0.95rem;
  }
  .ftr__newsletter iframe {
    display: block;
    width: 100%;
    min-height: 305px;
    border: 0;
    background: transparent;
  }
  .ftr__in {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .ftr__brand img {
    width: 165px;
    height: auto;
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }
  .ftr__brand p {
    margin: 1.2rem 0 1.4rem;
    max-width: 34ch;
    font-size: 0.95rem;
  }
  .ftr__social {
    display: flex;
    gap: 1.2rem;
  }
  .ftr__social a {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--sage);
  }
  .ftr h2 {
    margin-bottom: 1.1rem;
    color: #fff;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .ftr__in a {
    display: block;
    padding: 0.32rem 0;
    font-size: 0.95rem;
  }
  .ftr__in a:hover {
    color: #fff;
  }
  .ftr__addr {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
  }

  .ftr__base {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    max-width: var(--maxw);
    margin: clamp(3rem, 6vw, 5rem) auto 0;
    padding: 1.6rem var(--gutter) 0;
    border-top: 1px solid var(--line-light);
    font-size: 0.82rem;
  }
  .ftr__base nav {
    display: flex;
    gap: 1.6rem;
  }
  .ftr__base a:hover {
    color: #fff;
  }

  @media (max-width: 900px) {
    .ftr__newsletter {
      grid-template-columns: 1fr;
    }
    .ftr__in {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .ftr__in {
      grid-template-columns: 1fr;
    }
  }
</style>
