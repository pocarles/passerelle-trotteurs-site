---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import CtaBand from "../components/CtaBand.astro";
import {
  network,
  networkCommitments,
  networkConditions,
  site,
} from "../data/site";
---

<Base
  title="Le réseau accrédité — Association Passerelle"
  description="Consultez l’annuaire des 22 structures accréditées Passerelle et découvrez les engagements requis pour rejoindre le réseau."
>
  <PageHeader
    eyebrow="Notre réseau"
    title="Des professionnels engagés"
    accent="partout en France."
    lead="Les structures professionnelles de la reconversion sont sélectionnées selon des critères destinés à assurer le bien-être des chevaux réformés."
    image="/media/attelage.jpg"
    imageAlt="Un Trotteur Français réformé mené en attelage de loisir"
  />

  <section class="network-entry">
    <div class="wrap">
      <div class="network-entry__intro">
        <p class="eyebrow">Rejoindre le réseau Passerelle</p>
        <h2>
          Les critères et les engagements,
          <span class="accent"> en toute transparence.</span>
        </h2>
        <p class="lead">
          Pour devenir une structure accréditée, vous devez garantir une
          reconversion responsable, protectrice et durable pour chaque Trotteur
          Français accueilli.
        </p>
      </div>
      <nav class="network-entry__steps" aria-label="Découvrir le référencement">
        <a href="#conditions">
          <span>01</span>
          <strong>Les conditions d'entrée</strong>
          <small>Votre expérience, vos installations et votre organisation.</small>
        </a>
        <a href="#engagements">
          <span>02</span>
          <strong>Les engagements</strong>
          <small>Le bien-être, la protection et le suivi de chaque cheval.</small>
        </a>
        <a href="#candidater">
          <span>03</span>
          <strong>Votre candidature</strong>
          <small>Vous vous reconnaissez dans ce cadre&nbsp;? Échangeons.</small>
        </a>
      </nav>
      <div class="network-entry__cta">
        <p>
          Vous remplissez ces conditions&nbsp;?
          <span class="accent">Rejoignez-nous&nbsp;!</span>
        </p>
        <a class="btn btn--primary" href="/contact">Nous contacter</a>
      </div>
    </div>
  </section>

  <section class="section criteria" id="conditions">
    <div class="wrap">
      <div class="criteria__intro">
        <p class="eyebrow">Conditions de référencement</p>
        <h2>
          Votre structure doit réunir
          <span class="accent"> trois essentiels.</span>
        </h2>
        <p class="lead">
          Ces conditions permettent de s'assurer que les chevaux confiés au
          réseau Passerelle évoluent dans un environnement adapté à leur
          transition vers une nouvelle vie.
        </p>
      </div>
      <div class="criteria__grid">
        {
          networkConditions.map((condition) => (
            <article class="criteria-card">
              <span class="criteria-card__number">{condition.number}</span>
              <h3>{condition.title}</h3>
              <p>{condition.summary}</p>
              <ul>
                {condition.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section commitments-section" id="engagements">
    <div class="wrap">
      <div class="commitments-section__intro">
        <p class="eyebrow">Les engagements des structures accréditées</p>
        <h2>
          Une protection à chaque étape
          <span class="accent"> de la reconversion.</span>
        </h2>
        <p class="lead">
          Rejoindre le réseau Passerelle, c’est s'engager concrètement pour la
          qualité de vie, la traçabilité et l'avenir des Trotteurs Français.
        </p>
      </div>
      <div class="commitments">
        {
          networkCommitments.map((commitment, index) => (
            <article class:list={["commitment", { "commitment--feature": index === 0 }]}>
              <h3>{commitment.title}</h3>
              <p>{commitment.summary}</p>
              <ul>
                {commitment.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="directory__head">
        <div>
          <p class="eyebrow">Annuaire</p>
          <h2>{network.length} structures accréditées</h2>
        </div>
      </div>
      <ul class="directory">
        {
          network.map(([name, department]) => (
            <li>
              <span>{name}</span>
              <span class="directory__place">{department}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div id="candidater">
    <CtaBand
      text="Votre structure partage nos valeurs ?"
      accent="Faisons connaissance."
      label="Nous contacter"
      href="/contact"
      note={`Présentez-nous votre activité à ${site.email}.`}
      icon="users"
    />
  </div>

</Base>

<style>
  .network-entry {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--cream-warm);
    border-bottom: 1px solid var(--line);
  }
  .network-entry__intro {
    max-width: 68ch;
  }
  .network-entry__intro h2 {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 4vw, 3.35rem);
  }
  .network-entry__intro .lead {
    margin-bottom: 0;
  }
  .network-entry__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .network-entry__steps a {
    display: grid;
    gap: 0.35rem;
    min-height: 100%;
    padding: 1.25rem;
    color: inherit;
    text-decoration: none;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background-color 180ms ease;
  }
  .network-entry__steps a:hover {
    background: var(--cream);
  }
  .network-entry__steps span {
    color: var(--moss-mid);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .network-entry__steps strong {
    color: var(--forest);
    font-size: 0.98rem;
  }
  .network-entry__steps small {
    color: var(--ink-faint);
    font-size: 0.82rem;
    line-height: 1.45;
  }
  .network-entry__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .network-entry__cta {
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
    padding-top: clamp(2.25rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
  }
  .network-entry__cta p {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.45rem, 2.8vw, 2.2rem);
    line-height: 1.2;
  }

  .criteria {
    background: var(--cream);
  }
  .criteria__intro {
    max-width: 58ch;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .criteria__intro .lead {
    margin-bottom: 0;
  }
  .criteria__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .criteria-card {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.2rem);
    background: var(--cream-warm);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .criteria-card__number {
    display: block;
    margin-bottom: 1.5rem;
    color: var(--moss);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .criteria-card h3 {
    margin-bottom: 0.75rem;
    color: var(--forest);
  }
  .criteria-card > p {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .criteria-card ul,
  .commitment ul {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .criteria-card li,
  .commitment li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.55;
  }
  .criteria-card li + li,
  .commitment li + li {
    margin-top: 0.85rem;
  }
  .criteria-card li::before,
  .commitment li::before {
    content: "";
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--moss-mid);
  }

  .directory__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .directory {
    columns: 2;
    column-gap: clamp(2rem, 5vw, 4.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .directory li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    break-inside: avoid;
  }
  .directory__place {
    flex: 0 1 auto;
    min-width: 0;
    color: var(--ink-faint);
    font-size: 0.78rem;
    text-align: right;
  }
  .commitments-section {
    background: var(--cream-warm);
    border-block: 1px solid var(--line);
  }
  .commitments-section__intro {
    max-width: 64ch;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .commitments-section__intro .lead {
    margin-bottom: 0;
  }
  .commitments {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .commitment {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .commitment h3 {
    margin-bottom: 0.75rem;
    color: var(--forest);
  }
  .commitment > p {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .commitment--feature {
    grid-column: 1 / -1;
    background: var(--forest-deep);
    border-color: var(--forest-deep);
  }
  .commitment--feature h3 {
    color: #fff;
  }
  .commitment--feature > p,
  .commitment--feature li {
    color: rgba(255, 255, 255, 0.8);
  }
  .commitment--feature li::before {
    background: var(--sage);
  }

  @media (max-width: 900px) {
    .criteria__grid,
    .commitments {
      grid-template-columns: 1fr;
    }
    .commitment--feature {
      grid-column: auto;
    }
  }

  @media (max-width: 800px) {
    .network-entry__cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  @media (max-width: 680px) {
    .network-entry__steps {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .network-entry__cta {
      gap: 1.25rem;
    }
    .directory {
      columns: 1;
    }
    .directory li {
      flex-direction: column;
      gap: 0.15rem;
    }
    .directory__place {
      text-align: left;
    }
  }
</style>
