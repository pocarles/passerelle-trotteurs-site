---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import {
  networkCommitments,
  networkConditions,
  site,
} from "../data/site";

const commitmentIcons = ["heart", "shield", "hands"] as const;
---

<Base
  title="Le réseau accrédité — Association Passerelle"
  description="Consultez l’annuaire des 22 structures accréditées Passerelle et découvrez les engagements requis pour rejoindre le réseau."
>
  <PageHeader
    eyebrow="Notre réseau"
    title="Des professionnels engagés"
    accent="partout en France."
    lead="Les structures professionnelles de la reconversion sont sélectionnées selon des critères destinés à assurer le bien-être des chevaux reconvertis."
    image="/media/bond.jpg"
    video="/media/horse-caress.mp4"
    background
  >
    <Fragment slot="actions">
      <div class="network-header-actions">
        <a class="btn btn--ghost-light" href="/reseau/annuaire#annuaire">
          Voir l’annuaire <span class="btn__ico"><Icon name="arrow" /></span>
        </a>
        <a class="btn btn--primary" href="/reseau/annuaire#carte">
          Voir la carte <span class="btn__ico"><Icon name="map" /></span>
        </a>
      </div>
    </Fragment>
  </PageHeader>

  <section class="network-entry">
    <div class="wrap">
      <div class="network-entry__intro">
        <p class="eyebrow">Rejoindre le réseau Passerelle</p>
        <h2>
          Rejoindre un réseau de qualité
          <span class="accent"> de la reconversion.</span>
        </h2>
        <p class="lead">
          Pour devenir une structure accréditée, vous devez garantir une
          reconversion responsable, protectrice et durable pour chaque Trotteur
          Français accueilli.
        </p>
      </div>
      <nav class="network-entry__steps" aria-label="Découvrir le référencement">
        <a href="#conditions">
          <span>01</span>
          <strong>Les conditions d'entrée</strong>
          <small>Votre expérience, vos installations et votre organisation.</small>
        </a>
        <a href="#engagements">
          <span>02</span>
          <strong>Les engagements</strong>
          <small>Le bien-être, la protection et le suivi de chaque cheval.</small>
        </a>
        <a href="#candidater">
          <span>03</span>
          <strong>Votre candidature</strong>
          <small>Vous vous reconnaissez dans ce cadre&nbsp;? Échangeons.</small>
        </a>
      </nav>
    </div>
  </section>

  <details class="network-stage network-stage--criteria" id="conditions">
    <summary>
      <div class="wrap network-stage__summary">
        <div class="criteria__intro">
          <p class="eyebrow">Conditions de référencement</p>
          <h2>Votre structure doit réunir trois éléments essentiels.</h2>
          <p class="lead">
            Ces conditions permettent de s'assurer que les chevaux confiés au
            réseau Passerelle évoluent dans un environnement adapté à leur
            transition vers une nouvelle vie.
          </p>
        </div>
        <span class="network-stage__toggle" aria-hidden="true"></span>
      </div>
    </summary>
    <div class="network-stage__content">
      <div class="wrap">
        <div class="criteria__grid">
          {
            networkConditions.map((condition) => (
              <article class="criteria-card">
                <div class="criteria-card__title">
                  <span class="criteria-card__icon"><Icon name={condition.icon} /></span>
                  <h3>{condition.title}</h3>
                </div>
                <p>{condition.summary}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </details>

  <details class="network-stage network-stage--commitments" id="engagements">
    <summary>
      <div class="wrap network-stage__summary">
        <div class="commitments-section__intro">
          <p class="eyebrow">Les engagements des structures accréditées</p>
          <h2>
            Vos engagements auprès de nos
            <span class="accent"> Trotteurs en reconversion.</span>
          </h2>
          <p class="lead commitments-section__lead">
            Rejoindre le réseau Passerelle, c’est s'engager concrètement pour la
            qualité de vie, la traçabilité et l'avenir des Trotteurs Français.
          </p>
        </div>
        <span class="network-stage__toggle" aria-hidden="true"></span>
      </div>
    </summary>
    <div class="network-stage__content">
      <div class="wrap">
        <div class="commitments">
          {
            networkCommitments.map((commitment, index) => (
              <details class="commitment" open={index === 0}>
                <summary>
                  <span class="commitment__icon"><Icon name={commitmentIcons[index]} /></span>
                  <span class="commitment__summary-copy">
                    <span class="commitment__title">{commitment.title}</span>
                    <span class="commitment__summary">{commitment.summary}</span>
                  </span>
                  <span class="commitment__toggle" aria-hidden="true"></span>
                </summary>
                <div class="commitment__content">
                  <ul>
                    {commitment.items.map((item) => <li>{item}</li>)}
                  </ul>
                  {commitment.note && (
                    <aside class="commitment__note">
                      <strong>À noter.</strong> {commitment.note}
                    </aside>
                  )}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </details>

  <details class="network-stage network-stage--candidate" id="candidater">
    <summary>
      <div class="wrap network-stage__summary">
        <div class="candidate__intro">
          <p class="eyebrow">Votre candidature</p>
          <h2>
            Votre structure partage nos valeurs&nbsp;?
            <span class="accent"> Faisons connaissance.</span>
          </h2>
          <p class="lead">Vous vous reconnaissez dans ce cadre&nbsp;? Échangeons.</p>
        </div>
        <span class="network-stage__toggle" aria-hidden="true"></span>
      </div>
    </summary>
    <div class="network-stage__content">
      <CtaBand
        text="Votre structure partage nos valeurs ?"
        accent="Faisons connaissance."
        label="Nous contacter"
        href="/contact"
        note={`Présentez-nous votre activité à ${site.email}.`}
        icon="users"
      />
    </div>
  </details>

  <script>
    const commitmentPanels = document.querySelectorAll<HTMLDetailsElement>(".commitment");
    const networkStages = document.querySelectorAll<HTMLDetailsElement>(".network-stage");

    commitmentPanels.forEach((panel) => {
      panel.addEventListener("toggle", () => {
        if (!panel.open) return;

        commitmentPanels.forEach((otherPanel) => {
          if (otherPanel !== panel) otherPanel.open = false;
        });
      });
    });

    const openStageFromHash = () => {
      const stage = document.querySelector<HTMLDetailsElement>(window.location.hash);
      if (stage?.matches(".network-stage")) stage.open = true;
    };

    openStageFromHash();
    window.addEventListener("hashchange", openStageFromHash);

    const stageObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          (entry.target as HTMLDetailsElement).open = true;
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -22% 0px", threshold: 0.08 },
    );

    networkStages.forEach((stage) => stageObserver.observe(stage));
  </script>

</Base>

<style>
  .network-header-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .network-entry {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--cream-warm);
    border-bottom: 1px solid var(--line);
  }
  .network-entry__intro {
    max-width: none;
  }
  .network-entry__intro h2 {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 4vw, 3.35rem);
  }
  .network-entry__intro .lead {
    max-width: none;
    margin-bottom: 0;
  }
  .network-entry__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(2.25rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .network-entry__steps a {
    display: grid;
    gap: 0.35rem;
    min-height: 100%;
    padding: 1.25rem;
    color: inherit;
    text-decoration: none;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background-color 180ms ease;
  }
  .network-entry__steps a:hover {
    background: var(--cream);
  }
  .network-entry__steps span {
    color: var(--moss-mid);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .network-entry__steps strong {
    color: var(--forest);
    font-size: 0.98rem;
  }
  .network-entry__steps small {
    color: var(--ink-faint);
    font-size: 0.82rem;
    line-height: 1.45;
  }
  .network-stage {
    display: block;
    border-bottom: 1px solid var(--line);
  }
  .network-stage > summary {
    display: block;
    list-style: none;
    cursor: pointer;
  }
  .network-stage > summary::-webkit-details-marker {
    display: none;
  }
  .network-stage > summary:focus-visible {
    outline: 2px solid var(--moss-mid);
    outline-offset: -2px;
  }
  .network-stage__summary {
    position: relative;
    display: block;
    padding-block: clamp(3rem, 6vw, 5rem);
    padding-right: clamp(3.5rem, 7vw, 6rem);
  }
  .network-stage__toggle {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    color: var(--forest-deep);
    background: var(--sage);
    border-radius: 50%;
    transform: translateY(-50%);
  }
  .network-stage__toggle::before {
    content: "+";
    font-size: 1.6rem;
    line-height: 1;
  }
  .network-stage[open] .network-stage__toggle::before {
    content: "–";
  }
  .network-stage__content {
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .network-stage--criteria {
    background: var(--cream);
  }
  .criteria__intro {
    max-width: none;
    margin-bottom: 0;
  }
  .criteria__intro h2 {
    font-size: clamp(2rem, 3.7vw, 3.15rem);
  }
  .criteria__intro .lead {
    max-width: none;
    margin-bottom: 0;
  }
  .criteria__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .criteria-card {
    display: grid;
    grid-template-columns: minmax(22rem, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: clamp(1.5rem, 5vw, 4rem);
    padding: clamp(1.15rem, 2vw, 1.5rem) clamp(1.5rem, 4vw, 3rem);
    background: var(--forest-deep);
    border: 1px solid var(--forest-deep);
    border-radius: var(--radius-lg);
  }
  .criteria-card__title {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .criteria-card__icon {
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    color: var(--forest-deep);
    background: var(--sage);
    border-radius: 50%;
  }
  .criteria-card__icon :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .criteria-card h3 {
    font-size: clamp(1.45rem, 2vw, 1.9rem);
    color: #fff;
    white-space: nowrap;
  }
  .criteria-card > p {
    margin: 0;
    color: rgba(255, 255, 255, 0.84);
    line-height: 1.55;
  }
  .commitment ul {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .commitment li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.55;
  }
  .commitment li + li {
    margin-top: 0.85rem;
  }
  .commitment li::before {
    content: "";
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--moss-mid);
  }

  .network-stage--commitments {
    background: var(--cream-warm);
  }
  .commitments-section__intro {
    max-width: none;
    margin-bottom: 0;
  }
  .commitments-section__intro h2 {
    max-width: 28ch;
  }
  .commitments-section__lead {
    width: 100%;
    max-width: 100%;
    margin-bottom: 0;
  }
  .commitments {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .commitment {
    overflow: hidden;
    border-radius: var(--radius);
  }
  .commitment summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.85rem, 2vw, 1.25rem);
    padding: 1.15rem clamp(1.1rem, 3vw, 1.75rem);
    color: var(--forest);
    background: var(--cream);
    border: 1px solid var(--line);
    cursor: pointer;
    list-style: none;
  }
  .commitment summary::-webkit-details-marker {
    display: none;
  }
  .commitment__icon {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    color: var(--forest);
    background: color-mix(in srgb, var(--sage) 42%, transparent);
    border-radius: 50%;
  }
  .commitment__icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .commitment__summary-copy {
    min-width: 0;
  }
  .commitment__title,
  .commitment__summary {
    display: block;
  }
  .commitment__title {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.15;
  }
  .commitment__summary {
    margin-top: 0.28rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  .commitment__toggle {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    color: var(--forest);
    background: color-mix(in srgb, var(--sage) 42%, transparent);
    border-radius: 50%;
  }
  .commitment__toggle::before {
    content: "+";
    font-size: 1.35rem;
    line-height: 1;
  }
  .commitment[open] summary {
    background: var(--forest-deep);
    border-color: var(--forest-deep);
  }
  .commitment[open] .commitment__title {
    color: #fff;
  }
  .commitment[open] .commitment__summary {
    color: rgba(255, 255, 255, 0.8);
  }
  .commitment[open] .commitment__icon,
  .commitment[open] .commitment__toggle {
    color: var(--forest-deep);
    background: var(--sage);
  }
  .commitment[open] .commitment__toggle::before {
    content: "–";
  }
  .commitment__content {
    padding: clamp(1.35rem, 3vw, 1.85rem) clamp(1.1rem, 3vw, 1.75rem)
      clamp(1.25rem, 3vw, 1.75rem);
    background: var(--cream);
    border: 1px solid var(--line);
    border-top: 0;
    border-radius: 0 0 var(--radius) var(--radius);
  }
  .commitment__content ul {
    margin: 0;
  }
  .commitment__note {
    margin-top: 1.35rem;
    padding: 1rem 1.15rem;
    color: var(--ink-soft);
    background: color-mix(in srgb, var(--sage) 24%, transparent);
    border-left: 2px solid var(--sage);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .network-stage--candidate {
    background: var(--cream);
  }
  .network-stage--candidate .network-stage__content {
    padding-bottom: 0;
  }
  .candidate__intro {
    max-width: none;
  }
  .candidate__intro h2 {
    max-width: 28ch;
  }
  .candidate__intro .lead {
    max-width: none;
    margin-bottom: 0;
  }

  @media (max-width: 760px) {
    .criteria-card {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .criteria-card__title {
      padding: 0;
    }
    .criteria-card h3 {
      white-space: normal;
    }
    .commitment summary {
      align-items: start;
    }
    .commitment__toggle {
      margin-top: 0.15rem;
    }
    .network-stage__toggle {
      top: 2.75rem;
      transform: none;
    }
  }

  @media (max-width: 680px) {
    .network-entry__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
