---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import {
  links,
  network,
  networkCommitments,
  networkConditions,
  site,
} from "../data/site";
---

<Base
  title="Le réseau accrédité — Association Passerelle"
  description="Consultez l’annuaire des 22 structures accréditées Passerelle et découvrez les engagements requis pour rejoindre le réseau."
>
  <PageHeader
    eyebrow="Notre réseau"
    title="Des professionnels engagés"
    accent="partout en France."
    lead="Les structures professionnelles de la reconversion sont sélectionnées selon des critères destinés à assurer le bien-être des chevaux réformés."
    image="/media/attelage.jpg"
    imageAlt="Un Trotteur Français réformé mené en attelage de loisir"
  />

  <section class="network-entry">
    <div class="wrap">
      <div class="network-entry__document">
        <div>
          <p class="eyebrow">Avant de rejoindre le réseau</p>
          <h2>Consultez le <span class="accent">cahier des charges.</span></h2>
        </div>
        <a class="tlink" href={links.accreditation} target="_blank" rel="noreferrer">
          Lire le cahier des charges
          <Icon name="arrowUpRight" />
        </a>
      </div>
      <div class="network-entry__cta">
        <p class="network-entry__cta-text">
          Vous remplissez ces conditions&nbsp;?
          <span class="accent">Rejoignez-nous&nbsp;!</span>
        </p>
        <a class="btn btn--primary" href="/contact">
          Nous contacter
          <span class="btn__ico"><Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="directory__head">
        <div>
          <p class="eyebrow">Annuaire</p>
          <h2>{network.length} structures accréditées</h2>
        </div>
      </div>
      <ul class="directory">
        {
          network.map(([name, department]) => (
            <li>
              <span>{name}</span>
              <span class="directory__place">{department}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section criteria" id="conditions">
    <div class="wrap">
      <div class="criteria__intro">
        <p class="eyebrow">Conditions de référencement</p>
        <h2>Un cadre exigeant pour <span class="accent">une reconversion durable.</span></h2>
        <p class="lead">
          Avant de recevoir le dossier de demande de référencement, chaque
          structure est invitée à prendre connaissance des conditions suivantes.
        </p>
      </div>
      <div class="criteria__grid">
        {
          networkConditions.map((condition) => (
            <article class="criteria-card">
              <h3>{condition.title}</h3>
              <ul>
                {condition.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section join" id="engagements">
    <div class="wrap join__grid">
      <div class="join__intro">
        <p class="eyebrow eyebrow--light">Les engagements</p>
        <h2>Un cadre, un soutien, <span class="accent--light">un réseau.</span></h2>
        <p>
          Rejoindre le réseau Passerelle, c’est s’engager pour la qualité de
          vie, la traçabilité et la protection des Trotteurs Français.
        </p>
        <a class="tlink tlink--light" href={links.accreditation} target="_blank" rel="noreferrer">
          Consulter le document complet
          <Icon name="arrowUpRight" />
        </a>
      </div>
      <div class="commitments">
        {
          networkCommitments.map((commitment) => (
            <article class="commitment">
              <h3>{commitment.title}</h3>
              {commitment.intro && <p>{commitment.intro}</p>}
              <ul>
                {commitment.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    text="Tenté(e) par l’aventure Passerelle ?"
    accent="Recevez votre dossier de demande de référencement."
    label="Nous contacter"
    href="/contact"
    note={`Ou écrivez-nous directement à ${site.email}.`}
    icon="users"
  />

</Base>

<style>
  .network-entry {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--cream-warm);
    border-bottom: 1px solid var(--line);
  }
  .network-entry__document,
  .network-entry__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .network-entry__document h2 {
    font-size: clamp(1.8rem, 3vw, 2.7rem);
  }
  .network-entry__cta {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }
  .network-entry__cta-text {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.45rem, 2.8vw, 2.2rem);
    line-height: 1.2;
  }

  .criteria {
    background: var(--cream);
  }
  .criteria__intro {
    max-width: 58ch;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .criteria__intro .lead {
    margin-bottom: 0;
  }
  .criteria__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .criteria-card {
    padding: clamp(1.5rem, 3vw, 2.2rem);
    background: var(--cream-warm);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .criteria-card h3 {
    color: var(--forest);
  }
  .criteria-card ul,
  .commitment ul {
    margin: 1.35rem 0 0;
    padding: 0;
    list-style: none;
  }
  .criteria-card li,
  .commitment li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.55;
  }
  .criteria-card li + li,
  .commitment li + li {
    margin-top: 1rem;
  }
  .criteria-card li::before,
  .commitment li::before {
    content: "";
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--moss-mid);
  }

  .directory__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .directory {
    columns: 2;
    column-gap: clamp(2rem, 5vw, 4.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .directory li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    break-inside: avoid;
  }
  .directory__place {
    flex: 0 1 auto;
    min-width: 0;
    color: var(--ink-faint);
    font-size: 0.78rem;
    text-align: right;
  }
  .join {
    background: var(--forest-deep);
    color: #fff;
  }
  .join__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2.5rem, 7vw, 6rem);
  }
  .join__intro > p {
    max-width: 32ch;
    color: rgba(255, 255, 255, 0.78);
  }
  .join__intro .tlink {
    margin-top: 1.2rem;
  }
  .commitments {
    max-width: 70ch;
  }
  .commitment + .commitment {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line-light);
  }
  .commitment h3 {
    color: #fff;
  }
  .commitment p,
  .commitment li {
    color: rgba(255, 255, 255, 0.78);
  }
  .commitment li::before {
    background: var(--sage);
  }

  @media (max-width: 900px) {
    .criteria__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 800px) {
    .network-entry__document,
    .network-entry__cta {
      align-items: flex-start;
      flex-direction: column;
    }
    .join__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .directory {
      columns: 1;
    }
    .directory li {
      flex-direction: column;
      gap: 0.15rem;
    }
    .directory__place {
      text-align: left;
    }
  }
</style>
