---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Prose from "../../components/Prose.astro";
import Icon from "../../components/Icon.astro";
import CtaBand from "../../components/CtaBand.astro";
import { links, site, protections } from "../../data/site";
import {
  getHorses,
  statutLabel,
  statutDescription,
  horseAge,
} from "../../data/chevaux";

export async function getStaticPaths() {
  const horses = await getHorses();
  return horses.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const age = horseAge(d.annee);

const specs = [
  age !== null && { k: "Âge", v: `${age} ans (${d.annee})` },
  d.sexe && { k: "Sexe", v: d.sexe.charAt(0).toUpperCase() + d.sexe.slice(1) },
  d.robe && { k: "Robe", v: d.robe },
  d.taille && { k: "Taille", v: d.taille },
  { k: "Monté", v: d.montable ? "Oui" : "Non monté" },
  d.structure && { k: "Structure d’accueil", v: d.structure },
  d.departement && { k: "Localisation", v: d.departement },
  d.participation && { k: "Participation", v: d.participation },
].filter(Boolean) as { k: string; v: string }[];

const subject = encodeURIComponent(`Renseignements — ${d.nom}`);
---

<Base
  title={`${d.nom} — ${statutLabel[d.statut]} | Passerelle`}
  description={d.resume}
>
  <article class="sheet">
    <div class="wrap">
      <a class="tlink back" href="/adopter">
        <Icon name="arrow" class="back__ico" />
        Tous les trotteurs
      </a>

      <div class="sheet__top">
        <div class="gallery">
          {
            d.photos.length > 0 ? (
              d.photos.map((p: { src: string; alt: string }, i: number) => (
                <figure class={i === 0 ? "gallery__main" : ""}>
                  <img src={p.src} alt={p.alt} loading={i === 0 ? "eager" : "lazy"} />
                </figure>
              ))
            ) : (
              <figure class="gallery__main gallery__empty">
                <Icon name="horse" />
              </figure>
            )
          }
        </div>

        <div class="ident">
          <p class:list={["tag", `tag--${d.statut}`]}>{statutLabel[d.statut]}</p>
          <h1>{d.nom}</h1>
          {d.placed && <p class="placed">Ce cheval a trouvé sa famille.</p>}
          <p class="lead">{d.resume}</p>

          <dl class="specs">
            {
              specs.map((s) => (
                <div>
                  <dt>{s.k}</dt>
                  <dd>{s.v}</dd>
                </div>
              ))
            }
          </dl>

          {
            !d.placed && (
              <div class="actions">
                <a class="btn btn--primary" href={`mailto:${site.email}?subject=${subject}`}>
                  Se renseigner
                  <span class="btn__ico"><Icon name="arrow" /></span>
                </a>
                <a class="btn btn--ghost" href={`tel:${site.phone}`}>
                  {site.phoneDisplay}
                  <span class="btn__ico"><Icon name="arrow" /></span>
                </a>
              </div>
            )
          }
          {d.updated && (
            <p class="updated">
              Fiche mise à jour le{" "}
              <time datetime={d.updated.toISOString().slice(0, 10)}>
                {d.updated.toLocaleDateString("fr-FR", {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                })}
              </time>
            </p>
          )}
        </div>
      </div>

      <div class="sheet__body">
        <Prose>
          <Content />
        </Prose>

        <aside class="aside">
          <h2>{statutLabel[d.statut]}</h2>
          <p>{statutDescription[d.statut]}</p>
          <h2>La protection Passerelle</h2>
          <ul>
            {protections.map((p) => <li>{p}</li>)}
          </ul>
          <a class="tlink" href="/confier-et-proteger">
            Le contrat en détail
            <Icon name="arrow" />
          </a>
        </aside>
      </div>
    </div>
  </article>

  <CtaBand
    text="Ce cheval ne vous correspond pas&nbsp;?"
    accent="Dites-nous ce que vous cherchez."
    label="Nous écrire"
    href="/contact"
    icon="users"
    note="Nous connaissons les chevaux de notre réseau et nous pouvons vous orienter."
  />
</Base>

<style>
  .sheet {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
  }
  .back {
    margin-bottom: 2.5rem;
  }
  .back__ico {
    transform: rotate(180deg);
  }

  .sheet__top {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.8rem;
  }
  .gallery figure {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .gallery__main {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 3 !important;
    border-radius: var(--radius-lg) !important;
  }
  .gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery__empty {
    display: grid;
    place-items: center;
    background: var(--cream-warm);
    border: 1px solid var(--line);
    color: var(--line-strong);
  }
  .gallery__empty :global(svg) {
    width: 64px;
    height: 64px;
  }

  .tag {
    display: inline-block;
    margin: 0 0 1.1rem;
    padding: 0.36rem 0.8rem;
    border-radius: 999px;
    background: var(--forest);
    color: #fff;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .tag--adoption {
    background: var(--moss);
  }
  .tag--adoption-directe {
    background: var(--ink);
  }

  .ident h1 {
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
  }
  .placed {
    margin: 0.8rem 0 0;
    color: var(--moss);
    font-weight: 600;
  }
  .ident .lead {
    margin: 1.2rem 0 2rem;
  }

  .specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin: 0 0 2rem;
    border-top: 1px solid var(--line);
  }
  .specs > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .specs > div:nth-child(odd) {
    padding-right: 1.5rem;
  }
  .specs > div:nth-child(even) {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }
  .specs dt {
    color: var(--ink-faint);
    font-size: 0.8rem;
  }
  .specs dd {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 500;
    text-align: right;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .updated {
    margin: 1.4rem 0 0;
    color: var(--ink-faint);
    font-size: 0.8rem;
  }

  .sheet__body {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
    align-items: start;
  }

  .aside {
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--cream-warm);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .aside h2 {
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--moss);
  }
  .aside h2 + p,
  .aside h2 + ul {
    margin-top: 0.7rem;
  }
  .aside p {
    margin: 0 0 1.8rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .aside ul {
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  .aside li {
    position: relative;
    padding-left: 1.3rem;
    margin-bottom: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.88rem;
  }
  .aside li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--moss-mid);
  }

  @media (max-width: 900px) {
    .sheet__top,
    .sheet__body {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .specs {
      grid-template-columns: 1fr;
    }
    .specs > div:nth-child(odd),
    .specs > div:nth-child(even) {
      padding-inline: 0;
      border-left: 0;
    }
  }
</style>
