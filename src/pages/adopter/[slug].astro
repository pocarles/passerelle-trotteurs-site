---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Prose from "../../components/Prose.astro";
import Icon from "../../components/Icon.astro";
import { links, site, protections } from "../../data/site";
import {
  getHorses,
  statutLabel,
  statutDescription,
  horseAge,
} from "../../data/chevaux";

export async function getStaticPaths() {
  const horses = await getHorses();
  return horses.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const age = horseAge(d.annee);
const backHref =
  d.statut === "adoption-directe"
    ? "/adopter/adoption-directe"
    : d.statut === "vente"
      ? "/adopter/chevaux-a-la-vente"
      : "/adopter/chevaux-a-l-adoption";
const backLabel =
  d.statut === "adoption-directe"
    ? "Les chevaux en adoption directe"
    : d.statut === "vente"
      ? "Les chevaux à la vente"
      : "Les chevaux à l’adoption";

const specs = [
  age !== null && { k: "Âge", v: `${age} ans (${d.annee})` },
  d.sexe && { k: "Sexe", v: d.sexe.charAt(0).toUpperCase() + d.sexe.slice(1) },
  d.robe && { k: "Robe", v: d.robe },
  d.taille && { k: "Taille", v: d.taille },
  { k: "Monté", v: d.montabilite ?? (d.montable ? "Oui" : "Non monté") },
  d.structure && { k: "Structure d’accueil", v: d.structure },
  d.departement && { k: "Localisation", v: d.departement },
  d.participation && { k: "Participation", v: d.participation },
].filter(Boolean) as { k: string; v: string }[];

const subject = encodeURIComponent(d.nom);
const contactHref = `mailto:${site.email}?subject=${subject}`;
const phoneHref = d.contactPhone ?? site.phone;
const phoneLabel = d.contactPhoneDisplay ?? site.phoneDisplay;
---

<Base
  title={`${d.nom} — ${statutLabel[d.statut]} | Passerelle`}
  description={d.resume}
>
  <article class="sheet">
    <div class="wrap">
      <a class="tlink back" href={backHref}>
        <Icon name="arrow" class="back__ico" />
        {backLabel}
      </a>

      <div class="sheet__top">
        <div
          class="gallery"
          data-horse-gallery
          role="region"
          aria-label={`Photos de ${d.nom}`}
        >
          {
            d.photos.length > 0 ? (
              <>
                <div class="gallery__viewport" data-gallery-viewport>
                  {d.photos.map((p: { src: string; alt: string }, i: number) => (
                    <figure class="gallery__slide" data-gallery-slide>
                      <img src={p.src} alt={p.alt} loading={i === 0 ? "eager" : "lazy"} />
                    </figure>
                  ))}
                </div>

                {d.photos.length > 1 && (
                  <>
                    <button
                      class="gallery__arrow gallery__arrow--prev"
                      type="button"
                      data-gallery-prev
                      aria-label="Afficher la photo précédente"
                    >
                      <Icon name="arrow" />
                    </button>
                    <button
                      class="gallery__arrow gallery__arrow--next"
                      type="button"
                      data-gallery-next
                      aria-label="Afficher la photo suivante"
                    >
                      <Icon name="arrow" />
                    </button>
                    <p class="gallery__count" aria-live="polite">
                      <span data-gallery-current>1</span> / {d.photos.length}
                    </p>
                    <div class="gallery__dots" aria-label="Choisir une photo">
                      {d.photos.map((_: { src: string; alt: string }, i: number) => (
                        <button
                          type="button"
                          data-gallery-dot
                          aria-label={`Afficher la photo ${i + 1}`}
                          aria-current={i === 0 ? "true" : "false"}
                        />
                      ))}
                    </div>
                  </>
                )}
              </>
            ) : (
              <figure class="gallery__empty">
                <Icon name="horse" />
              </figure>
            )
          }
        </div>

        <div class="ident">
          <p class:list={["tag", `tag--${d.statut}`]}>{statutLabel[d.statut]}</p>
          <h1>{d.nom}</h1>
          {d.placed && <p class="placed">Ce cheval a trouvé sa famille.</p>}
          <p class="lead">{d.resume}</p>

          <dl class="specs">
            {
              specs.map((s) => (
                <div>
                  <dt>{s.k}</dt>
                  <dd>{s.v}</dd>
                </div>
              ))
            }
          </dl>

          {
            !d.placed && (
              <div class="actions">
                <a class="btn btn--primary" href={contactHref}>
                  Se renseigner
                  <span class="btn__ico"><Icon name="arrow" /></span>
                </a>
                <a class="btn btn--ghost" href={`tel:${phoneHref}`}>
                  {phoneLabel}
                  <span class="btn__ico"><Icon name="arrow" /></span>
                </a>
              </div>
            )
          }
          {d.updated && (
            <p class="updated">
              Fiche mise à jour le{" "}
              <time datetime={d.updated.toISOString().slice(0, 10)}>
                {d.updated.toLocaleDateString("fr-FR", {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                })}
              </time>
            </p>
          )}
        </div>
      </div>

      <div class="sheet__body">
        <Prose>
          <Content />
        </Prose>

        <aside class="aside">
          <h2>{statutLabel[d.statut]}</h2>
          <p>{statutDescription[d.statut]}</p>
          <h2>La protection Passerelle</h2>
          <ul>
            {protections.map((p) => <li>{p}</li>)}
          </ul>
          <a class="tlink" href="/confier-et-proteger">
            Le contrat en détail
            <Icon name="arrow" />
          </a>
        </aside>
      </div>
    </div>
  </article>

</Base>

<script>
  document.querySelectorAll<HTMLElement>("[data-horse-gallery]").forEach((gallery) => {
    const viewport = gallery.querySelector<HTMLElement>("[data-gallery-viewport]");
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>("[data-gallery-slide]"));
    const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-dot]"));
    const current = gallery.querySelector<HTMLElement>("[data-gallery-current]");
    const previous = gallery.querySelector<HTMLButtonElement>("[data-gallery-prev]");
    const next = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");

    if (!viewport || slides.length < 2 || !previous || !next) return;

    let activeIndex = 0;
    let scrollFrame = 0;

    const update = (index: number) => {
      activeIndex = index;
      if (current) current.textContent = String(index + 1);
      dots.forEach((dot, dotIndex) => {
        dot.setAttribute("aria-current", dotIndex === index ? "true" : "false");
      });
    };

    const show = (index: number) => {
      const targetIndex = (index + slides.length) % slides.length;
      viewport.scrollTo({ left: slides[targetIndex].offsetLeft, behavior: "smooth" });
      update(targetIndex);
    };

    previous.addEventListener("click", () => show(activeIndex - 1));
    next.addEventListener("click", () => show(activeIndex + 1));
    dots.forEach((dot, index) => dot.addEventListener("click", () => show(index)));

    viewport.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(scrollFrame);
        scrollFrame = requestAnimationFrame(() => {
          const index = Math.round(viewport.scrollLeft / viewport.clientWidth);
          update(Math.max(0, Math.min(index, slides.length - 1)));
        });
      },
      { passive: true },
    );
  });
</script>

<style>
  .sheet {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
  }
  .back {
    margin-bottom: 2.5rem;
  }
  .back__ico {
    transform: rotate(180deg);
  }

  .sheet__top {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .gallery {
    position: relative;
    min-width: 0;
  }
  .gallery__viewport {
    display: flex;
    overflow-x: auto;
    border-radius: var(--radius-lg);
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }
  .gallery__viewport::-webkit-scrollbar {
    display: none;
  }
  .gallery__slide,
  .gallery__empty {
    flex: 0 0 100%;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .gallery img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    width: 46px;
    height: 46px;
    padding: 0;
    place-items: center;
    transform: translateY(-50%);
    border: 1px solid rgba(31, 42, 31, 0.14);
    border-radius: 50%;
    background: rgba(249, 247, 241, 0.92);
    color: var(--forest-deep);
    box-shadow: 0 5px 18px rgba(31, 42, 31, 0.12);
    cursor: pointer;
    transition: background 160ms ease, transform 160ms ease;
  }
  .gallery__arrow:hover {
    background: var(--sage);
    transform: translateY(-50%) scale(1.04);
  }
  .gallery__arrow:focus-visible {
    outline: 2px solid var(--moss);
    outline-offset: 3px;
  }
  .gallery__arrow :global(svg) {
    width: 20px;
    height: 20px;
  }
  .gallery__arrow--prev {
    left: 1rem;
  }
  .gallery__arrow--prev :global(svg) {
    transform: rotate(180deg);
  }
  .gallery__arrow--next {
    right: 1rem;
  }
  .gallery__count {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    margin: 0;
    padding: 0.34rem 0.62rem;
    border-radius: 999px;
    background: rgba(31, 42, 31, 0.78);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .gallery__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }
  .gallery__dots button {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--line-strong);
    cursor: pointer;
    transition: width 160ms ease, background 160ms ease;
  }
  .gallery__dots button[aria-current="true"] {
    width: 25px;
    border-radius: 999px;
    background: var(--moss-mid);
  }
  .gallery__empty {
    display: grid;
    place-items: center;
    background: var(--cream-warm);
    border: 1px solid var(--line);
    color: var(--line-strong);
  }
  .gallery__empty :global(svg) {
    width: 64px;
    height: 64px;
  }

  .tag {
    display: inline-block;
    margin: 0 0 1.1rem;
    padding: 0.36rem 0.8rem;
    border-radius: 999px;
    background: var(--forest);
    color: #fff;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .tag--adoption {
    background: var(--moss);
  }
  .tag--adoption-directe {
    background: var(--ink);
  }

  .ident h1 {
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
  }
  .placed {
    margin: 0.8rem 0 0;
    color: var(--moss);
    font-weight: 600;
  }
  .ident .lead {
    margin: 1.2rem 0 2rem;
  }

  .specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    margin: 0 0 2rem;
    border-top: 1px solid var(--line);
  }
  .specs > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .specs > div:nth-child(odd) {
    padding-right: 1.5rem;
  }
  .specs > div:nth-child(even) {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }
  .specs dt {
    color: var(--ink-faint);
    font-size: 0.8rem;
  }
  .specs dd {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 500;
    text-align: right;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .updated {
    margin: 1.4rem 0 0;
    color: var(--ink-faint);
    font-size: 0.8rem;
  }

  .sheet__body {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
    align-items: start;
  }

  .aside {
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--cream-warm);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .aside h2 {
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--moss);
  }
  .aside h2 + p,
  .aside h2 + ul {
    margin-top: 0.7rem;
  }
  .aside p {
    margin: 0 0 1.8rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .aside ul {
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  .aside li {
    position: relative;
    padding-left: 1.3rem;
    margin-bottom: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.88rem;
  }
  .aside li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--moss-mid);
  }

  @media (max-width: 900px) {
    .sheet__top,
    .sheet__body {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .specs {
      grid-template-columns: 1fr;
    }
    .specs > div:nth-child(odd),
    .specs > div:nth-child(even) {
      padding-inline: 0;
      border-left: 0;
    }
  }
</style>
