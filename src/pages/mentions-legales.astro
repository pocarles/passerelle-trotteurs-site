---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Prose from "../components/Prose.astro";
import { legal, site } from "../data/site";
---

<Base
  title="Mentions légales — Association Passerelle"
  description="Mentions légales du site public de l’Association Passerelle : éditeur, siège, direction de publication, hébergement et juridiction."
>
  <PageHeader
    eyebrow="Informations légales"
    title="Mentions"
    accent="légales."
    lead="Informations relatives à l’édition et à l’hébergement du site de l’Association Passerelle."
  />

  <section class="section">
    <div class="wrap">
      <Prose>
        <h2>Éditeur du site</h2>
        <p>
          <strong>{legal.publisher}</strong><br />
          Association loi 1901<br />
          SIREN&nbsp;: {legal.siren}<br />
          Siège social&nbsp;: {site.address.street}, {site.address.postalCode} {site.address.city}, {site.address.country}
        </p>
        <p>
          Téléphone&nbsp;: <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a><br />
          Courriel&nbsp;: <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>

        <h2>Directeur de la publication</h2>
        <p>{legal.director}</p>

        <h2>Hébergeur</h2>
        <p>
          <strong>{legal.host.name}</strong><br />
          {legal.host.address}
        </p>

        <h2>Propriété intellectuelle</h2>
        <p>
          Les textes, photographies, éléments graphiques, logos et contenus
          présents sur ce site sont la propriété de l’Association Passerelle ou
          sont utilisés avec l’autorisation de leurs titulaires. Toute
          reproduction, représentation ou adaptation sans autorisation préalable
          est interdite.
        </p>

        <h2>Crédits photographiques</h2>
        <p>
          Certaines photographies de la section «&nbsp;Pour quels chevaux&nbsp;?&nbsp;»
          sont utilisées sous licences ouvertes&nbsp;:
        </p>
        <ul>
          <li>
            «&nbsp;Poulain dans un pré&nbsp;» — Annie Spratt,
            <a href="https://unsplash.com/photos/a-brown-horse-standing-on-top-of-a-lush-green-field-jFCTHba6HHc" target="_blank" rel="noreferrer">licence Unsplash</a>.
          </li>
          <li>
            «&nbsp;Course trotteurs Saint-Jean-des-Prés&nbsp;» — Amélie Tsaag
            Valren,
            <a href="https://commons.wikimedia.org/wiki/File:Course_trotteurs_Saint-Jean-des-Pr%C3%A9s_(2).jpg" target="_blank" rel="noreferrer">CC BY-SA 4.0</a>.
          </li>
          <li>
            «&nbsp;Haras du Pin jument et poulain TF&nbsp;» — Eponimm,
            <a href="https://commons.wikimedia.org/wiki/File:Haras_du_Pin_jument_et_poulain_TF.JPG" target="_blank" rel="noreferrer">CC BY-SA 3.0</a>.
          </li>
        </ul>

        <h2>Crédits vidéo</h2>
        <ul>
          <li>
            «&nbsp;Petting brown horse&nbsp;» — Dario Fernandez Ruz,
            <a href="https://www.pexels.com/video/petting-brown-horse-6876681/" target="_blank" rel="noreferrer">licence Pexels</a>.
          </li>
          <li>
            «&nbsp;Man walking with horse on sunlit path through trees&nbsp;» — Paolo San,
            <a href="https://www.pexels.com/video/man-walking-to-horse-on-ground-road-12932128/" target="_blank" rel="noreferrer">licence Pexels</a>.
          </li>
        </ul>

        <h2>Juridiction compétente</h2>
        <p>{legal.jurisdiction}</p>
      </Prose>
    </div>
  </section>
</Base>

<style>
  :global(.prose a) {
    overflow-wrap: anywhere;
  }
</style>
