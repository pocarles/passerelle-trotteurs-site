---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import { intakeProfiles, protections } from "../data/site";
---

<Base
  title="La protection Passerelle — Un contrat pour la vie"
  description="Découvrez les six protections contractuelles qui accompagnent à vie chaque Trotteur Français reconverti par Passerelle."
>
  <PageHeader
    eyebrow="Confier & protéger"
    title="Un cadre sécurisé et sécurisant pour les protéger et les suivre"
    accent="pour le reste de leur vie."
    lead="La protection Passerelle s’applique à tous les chevaux reconvertis par l’association, quel que soit leur parcours après les courses."
    video="/media/mecenes-preparation-setf.mp4"
    background
  />

  <section class="section why">
    <div class="wrap why__grid">
      <div class="why__intro">
        <p class="eyebrow">Pourquoi choisir Passerelle&nbsp;?</p>
        <h2>Une prise en charge <span class="accent">pensée pour leur avenir.</span></h2>
      </div>
      <div class="why__content">
        <p>
          Notre partenariat avec la SETF permet d’accompagner chaque Trotteur
          dès sa sortie des courses. Il bénéficie d’une reconversion adaptée,
          d’une protection contractuelle et d’un suivi tout au long de sa vie.
        </p>
        <ul class="why__list">
          <li><strong>Un réseau reconnu</strong> de professionnels formés à la reconversion.</li>
          <li><strong>Un contrat protecteur</strong> qui encadre chaque placement.</li>
          <li><strong>Un suivi à vie</strong> pour ne jamais perdre la trace du cheval.</li>
        </ul>
        <a
          class="btn btn--primary"
          href="https://intranet.passerelle-trotteurs.fr/user/login?destination=/accueil"
          target="_blank"
          rel="noreferrer"
        >
          Faire une demande de prise en charge
          <span class="btn__ico"><Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section profiles-sec">
    <div class="wrap">
      <p class="eyebrow">Propriétaires · Entraîneurs · Éleveurs</p>
      <h2 class="profiles__title">Pour quels chevaux&nbsp;?</h2>
      <div class="profiles__details">
        <p>
          Passerelle prend en charge uniquement les chevaux Trotteurs Français
          sortant de la filière course. Pour organiser leur départ, vous devez
          disposer du carnet et de la carte de propriétaire.
        </p>
        <p>
          Selon son âge, son état de santé et ses capacités — montable ou non,
          sain ou convalescent — nous pouvons reprendre votre cheval suivant
          une grille tarifaire pré-établie. Pour fluidifier les délais de prise
          en charge, <strong class="profiles__donation">nous privilégions toutefois le don, avec une réduction d’impôt à la clé.</strong>
        </p>
        <p>
          Nous nous engageons à orienter votre cheval vers une&nbsp;
          <a href="/reseau">structure d’accueil affiliée Passerelle</a> dans
          les plus brefs délais.
        </p>
      </div>
      <ul class="profiles">
        {
          intakeProfiles.map((profile) => (
            <li>
              <figure class="profiles__image" style={`--profile-image: url(${profile.image});`}>
                <img src={profile.image} alt={profile.alt} loading="lazy" />
              </figure>
              <span class="badge"><Icon name="horse" /></span>
              <h3>{profile.title}</h3>
              <p>{profile.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="notice-sec">
    <div class="wrap">
      <div class="notice">
        <span class="notice__ico"><Icon name="info" /></span>
        <div>
          <h3>Nos capacités d’accueil sont actuellement limitées.</h3>
          <p>
            Nos structures sont saturées. Les chevaux peuvent être inscrits sur
            liste d’attente, sans garantie de délai. Passerelle peut également
            fournir un contrat protecteur pour encadrer un placement direct.
          </p>
        </div>
        <a class="btn btn--ghost" href="/contact">
          Nous contacter
          <span class="btn__ico"><Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section benefits">
    <div class="wrap">
      <p class="eyebrow eyebrow--light">Une garantie partagée</p>
      <h2 class="benefits__title">Protéger le cheval, <span class="accent--light">sécuriser chaque partie.</span></h2>
      <div class="benefits__grid">
        <article>
          <figure class="benefits__image">
            <img
              src="/media/protection/professionnels-courses-trot.jpg"
              alt="Trotteur en course de trot attelé"
              loading="lazy"
            />
          </figure>
          <div class="benefits__heading">
            <span class="badge"><Icon name="horse" /></span>
            <h3>Pour les professionnels des courses</h3>
          </div>
          <p>
            Le professionnel sait que son cheval passe entre les mains d’une
            équipe formée à la reconversion, qui connaît le monde des courses,
            notamment l’entraînement des chevaux de course. Il bénéficie de la
            garantie contractuelle de la meilleure «&nbsp;seconde vie&nbsp;»
            possible pour son cheval, à l’issue de sa carrière.
          </p>
        </article>
        <article>
          <figure class="benefits__image">
            <img
              src="/media/pathway-adoption.jpg"
              alt="Cavalière de club avec un Trotteur Français"
              loading="lazy"
            />
          </figure>
          <div class="benefits__heading">
            <span class="badge"><Icon name="heart" /></span>
            <h3>Pour les cavaliers</h3>
          </div>
          <p>
            L’opportunité d’acheter en toute tranquillité, sous contrat, un
            cheval qui a bénéficié des meilleurs soins et d’un travail adapté à
            ses capacités physiques et mentales.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section protect">
    <div class="protect__lock" aria-hidden="true">
      <span class="protect__lock-shackle"></span>
      <span class="protect__lock-body"></span>
    </div>
    <div class="wrap protect__grid">
      <div>
        <p class="eyebrow">Six protections</p>
        <h2>La protection Passerelle <span class="accent">pour tous.</span></h2>
      </div>
      <ol class="protect__list">
        {
          protections.map((protection, index) => (
            <li>
              <span class="protect__num">{String(index + 1).padStart(2, "0")}</span>
              <span>{protection}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .why {
    background: var(--cream-warm);
    border-bottom: 1px solid var(--line);
  }
  .why__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2.5rem, 8vw, 7rem);
    align-items: start;
  }
  .why h2 {
    max-width: 14ch;
  }
  .why__content > p {
    margin: 0;
    max-width: 58ch;
    color: var(--ink-soft);
    font-size: 1.08rem;
    line-height: 1.65;
  }
  .why__list {
    display: grid;
    gap: 0.85rem;
    margin: 1.8rem 0 2rem;
    padding: 0;
    list-style: none;
  }
  .why__list li {
    padding-left: 1.15rem;
    border-left: 2px solid var(--sage);
    color: var(--ink-soft);
  }
  .why__list strong {
    color: var(--ink);
  }

  .profiles__title {
    margin-bottom: 3rem;
  }
  .profiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.8rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .profiles h3 {
    margin: 1.2rem 0 0.5rem;
  }
  .profiles__image {
    position: relative;
    display: grid;
    place-items: center;
    isolation: isolate;
    aspect-ratio: 1.45;
    margin: 0 0 1.2rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--cream-warm);
  }
  .profiles__image::before,
  .profiles__image::after {
    position: absolute;
    content: "";
    pointer-events: none;
  }
  .profiles__image::before {
    z-index: -2;
    inset: -1.5rem;
    background: center / cover no-repeat var(--profile-image);
    filter: blur(1rem);
    opacity: 0.38;
    transform: scale(1.08);
  }
  .profiles__image::after {
    z-index: -1;
    inset: 0;
    background: rgb(248 245 238 / 0.16);
  }
  .profiles__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .profiles p {
    margin: 0;
    color: var(--ink-soft);
  }
  .profiles__details {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(1.7rem, 3vw, 2.4rem);
    border-bottom: 1px solid var(--line);
  }
  .profiles__details p {
    max-width: none;
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.65;
  }
  .profiles__donation {
    color: var(--ink);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--moss-mid);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  .profiles__details a {
    color: var(--moss);
    font-weight: 600;
    text-decoration-color: var(--moss-mid);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }
  .notice-sec {
    padding-block: 0 clamp(2.25rem, 4.5vw, 3.5rem);
  }
  .notice {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 3vw, 2.4rem);
    padding: clamp(1.6rem, 3vw, 2.2rem);
    border: 1px solid var(--line);
    border-left: 3px solid var(--moss-mid);
    border-radius: var(--radius);
    background: var(--cream-warm);
  }
  .notice__ico {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: var(--moss);
  }
  .notice__ico :global(svg) {
    width: 30px;
    height: 30px;
  }
  .notice h3 {
    margin-bottom: 0.35rem;
    font-family: var(--sans);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .notice p {
    max-width: 62ch;
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .notice .btn {
    flex: 0 0 auto;
  }

  .protect {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--cream-warm);
    color: var(--ink);
    border-top: 1px solid var(--line);
  }
  .protect__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }
  .protect__lock {
    position: absolute;
    z-index: 2;
    bottom: clamp(1rem, 3vw, 3rem);
    left: clamp(1rem, 5vw, 5rem);
    width: clamp(12rem, 18vw, 20rem);
    aspect-ratio: 0.78;
    opacity: 0.16;
    pointer-events: none;
  }
  .protect__lock::before {
    position: absolute;
    right: 10%;
    bottom: -3%;
    left: 10%;
    height: 10%;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.32);
    content: "";
    filter: blur(7px);
  }
  .protect__lock-shackle {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 20%;
    width: 60%;
    height: 61%;
    border: clamp(9px, 0.85vw, 14px) solid var(--moss);
    border-bottom: 0;
    border-radius: 50% 50% 0 0 / 64% 64% 0 0;
    box-shadow:
      inset clamp(2px, 0.22vw, 4px) 0 0 rgba(255, 255, 255, 0.2),
      0 clamp(2px, 0.25vw, 5px) 0 rgba(0, 0, 0, 0.12);
    transform-origin: 8% 100%;
    animation: protect-lock-shackle 8s cubic-bezier(0.55, 0, 0.2, 1) infinite;
  }
  .protect__lock-shackle::before {
    position: absolute;
    inset: clamp(4px, 0.4vw, 7px) clamp(4px, 0.4vw, 7px) 0;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-bottom: 0;
    border-radius: inherit;
    content: "";
  }
  .protect__lock-body {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    left: 0;
    height: 58%;
    border: clamp(9px, 0.85vw, 14px) solid var(--moss);
    border-radius: 14% 14% 9% 9%;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.2), transparent 35%),
      linear-gradient(155deg, rgba(110, 139, 61, 0.35), rgba(31, 61, 43, 0.12));
    box-shadow:
      inset 0 clamp(3px, 0.35vw, 6px) 0 rgba(255, 255, 255, 0.2),
      inset 0 -5px 0 rgba(0, 0, 0, 0.16),
      0 7px 13px rgba(0, 0, 0, 0.12);
    transform-origin: 50% 100%;
    animation: protect-lock-body 8s ease-in-out infinite;
  }
  .protect__lock-body::before {
    position: absolute;
    top: 32%;
    left: 50%;
    width: clamp(1rem, 1.7vw, 1.5rem);
    height: clamp(1rem, 1.7vw, 1.5rem);
    border-radius: 50%;
    background: rgba(7, 37, 24, 0.78);
    content: "";
    transform: translateX(-50%);
  }
  .protect__lock-body::after {
    position: absolute;
    top: calc(32% + clamp(0.8rem, 1.35vw, 1.2rem));
    left: 50%;
    width: clamp(0.38rem, 0.65vw, 0.6rem);
    height: clamp(1.3rem, 2.1vw, 1.9rem);
    border-radius: 0 0 999px 999px;
    background: rgba(7, 37, 24, 0.78);
    content: "";
    transform: translateX(-50%);
  }
  @keyframes protect-lock-shackle {
    0%,
    18% {
      transform: translateY(-11%) rotate(-30deg);
    }
    34% {
      transform: translateY(2%) rotate(3deg);
    }
    42%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
  }
  @keyframes protect-lock-body {
    0%,
    24% {
      transform: scale(1);
    }
    34% {
      transform: scale(0.975, 0.955);
    }
    43% {
      transform: scale(1.02, 0.985);
    }
    52%,
    100% {
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .protect__lock-shackle,
    .protect__lock-body {
      animation: none;
      transform: none;
    }
  }
  .protect h2 {
    color: var(--ink);
  }
  .protect__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--line-strong);
  }
  .protect__list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem 1.4rem;
    background: var(--card);
  }
  .protect__num {
    flex: 0 0 auto;
    color: var(--moss);
    font-family: var(--serif);
  }
  .benefits__title {
    max-width: 22ch;
    margin-bottom: 3rem;
  }
  .section.benefits {
    padding-top: clamp(3.5rem, 7vw, 6rem);
    background: var(--forest-deep);
    color: rgba(255, 255, 255, 0.82);
  }
  .benefits__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .benefits article {
    position: relative;
    padding-top: 0;
  }
  .benefits__image {
    aspect-ratio: 16 / 9;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--cream-warm);
  }
  .benefits__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .benefits article .badge {
    flex: 0 0 auto;
  }
  .benefits__heading {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0.8rem 0 0.7rem;
  }
  .benefits h3 {
    margin: 0;
    color: var(--sage);
  }
  .benefits p {
    max-width: 50ch;
    color: rgba(255, 255, 255, 0.78);
  }
  .benefits article .badge {
    background: var(--sage);
    color: var(--forest-deep);
  }

  @media (max-width: 860px) {
    .why__grid,
    .profiles,
    .profiles__details,
    .protect__grid,
    .benefits__grid {
      grid-template-columns: 1fr;
    }
    .protect__lock {
      left: 1rem;
      bottom: 1rem;
      width: 9rem;
    }
  }
  @media (max-width: 720px) {
    .notice {
      flex-direction: column;
      align-items: flex-start;
      border-radius: var(--radius-lg);
    }
  }
  @media (max-width: 620px) {
    .protect__list {
      grid-template-columns: 1fr;
    }
  }
</style>
