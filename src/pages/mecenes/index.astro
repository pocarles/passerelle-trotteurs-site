---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { meceneGroupes, ambassadeurs } from "../../data/mecenes";

const total = meceneGroupes.reduce((n, g) => n + g.membres.length, 0);

const routes = [
  {
    eyebrow: "Nos mécènes",
    title: "Celles et ceux qui rendent notre action possible.",
    body: `${total} institutions, hippodromes, entreprises et médias accompagnent Passerelle au quotidien.`,
    href: "/mecenes/nos-mecenes",
    label: "Découvrir les mécènes",
    image: "/media/mecenes-hero.jpg",
    alt: "Le public et les professionnels réunis lors d’une journée sur un hippodrome",
  },
  {
    eyebrow: "Nos ambassadeurs",
    title: "Des histoires qui donnent un avenir aux trotteurs.",
    body: "Ils vivent la reconversion au quotidien et font connaître les multiples vies possibles après les courses.",
    href: "/mecenes/nos-ambassadeurs",
    label: "Découvrir nos ambassadeurs",
    image: "/media/ambassadeurs/darling-1.jpg",
    alt: "Jade et Darling des Mares, ambassadrices Passerelle",
  },
];
---

<Base
  title="Ils nous soutiennent — Association Passerelle"
  description="Découvrez les mécènes et les ambassadeurs qui accompagnent Passerelle et la reconversion des Trotteurs Français."
>
  <PageHeader
    eyebrow="Ils nous soutiennent"
    title="Découvrez celles et ceux"
    secondLine="qui font avancer"
    accent="la reconversion."
    compactTitle
    class="mecenes-header"
    lead="Institutions, hippodromes, entreprises, médias et ambassadeurs : toutes et tous contribuent à offrir un avenir aux Trotteurs Français après les courses."
    video="/media/mecenes-preparation-setf.mp4"
    background
  />

  <section class="section pathways">
    <div class="wrap">
      <div class="cards">
        {
          routes.map((route) => (
            <article class="card">
              <img class="card__media" src={route.image} alt={route.alt} loading="lazy" />
              <div class="card__body">
                <p class="eyebrow">{route.eyebrow}</p>
                <h2>{route.title}</h2>
                <p>{route.body}</p>
                <a class="tlink" href={route.href}>
                  {route.label}
                  <Icon name="arrow" />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    text="Votre entreprise souhaite soutenir la reconversion des trotteurs ?"
    accent="Parlons-en."
    label="Nous contacter"
    href="/contact"
    icon="users"
    note="Le mécénat d’entreprise ouvre droit à une réduction d’impôt de 60 % du montant du don."
    className="cta-sec--compact"
  />
</Base>

<style>
  :global(.mecenes-header.ph--compact-title h1) {
    font-size: clamp(2.3rem, 3.4vw, 3.25rem);
  }

  .pathways {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--card);
  }
  .card__media {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .card:nth-child(2) .card__media {
    object-position: center 38%;
  }
  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.5rem, 3vw, 2.2rem);
  }
  .card__body .eyebrow {
    margin-bottom: 0.8rem;
  }
  .card h2 {
    max-width: 18ch;
    font-size: clamp(1.7rem, 3vw, 2.35rem);
  }
  .card__body > p:not(.eyebrow) {
    flex: 1;
    margin: 1rem 0 1.6rem;
    color: var(--ink-soft);
  }

  @media (max-width: 760px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
