---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";

const applicationUrl = "https://forms.gle/kzGNk5qNMoY6XqgC9";

const missions = [
  {
    icon: "heart",
    title: "Raconter une histoire vraie",
    text: "Partager le parcours de votre trotteur, ses progrès et la relation que vous construisez ensemble.",
  },
  {
    icon: "horse",
    title: "Montrer sa polyvalence",
    text: "Faire découvrir au plus grand nombre les multiples vies possibles après une carrière de courses.",
  },
  {
    icon: "users",
    title: "Faire connaître la reconversion",
    text: "Porter les valeurs de bien-être, de patience et d’engagement défendues par Passerelle.",
  },
];
---

<Base
  title="Devenir ambassadeur 2027 — Association Passerelle"
  description="Découvrez le programme des ambassadeurs Passerelle 2027 et les périodes de candidature pour les propriétaires de trotteurs."
>
  <PageHeader
    eyebrow="Campagne 2027"
    title="Devenez ambassadeur"
    accent="de la reconversion."
    lead="Aux côtés de votre trotteur, faites connaître ce que la reconversion rend possible et inspirez de nouvelles histoires."
    image="/media/ambassadeurs/darling-4.jpg"
    imageAlt="Une ambassadrice Passerelle avec sa trotteuse"
  >
    <Fragment slot="actions">
      <a class="btn btn--primary" href="#candidater">
        Voir les candidatures
        <span class="btn__ico"><Icon name="arrow" /></span>
      </a>
    </Fragment>
  </PageHeader>

  <section class="section programme">
    <div class="wrap">
      <div class="programme__intro">
        <p class="eyebrow">Le programme</p>
        <h2>Faire vivre la reconversion <span class="accent">au quotidien.</span></h2>
        <p>
          Le programme s’adresse aux propriétaires de trotteurs qui souhaitent témoigner de
          leur parcours et contribuer à faire évoluer le regard porté sur les chevaux réformés
          des courses. Qu’ils soient issus du réseau Passerelle ou non, les futurs ambassadeurs
          partagent une même envie&nbsp;: montrer tout ce dont un trotteur est capable après les
          pistes.
        </p>
      </div>

      <ul class="missions">
        {missions.map((mission) => (
          <li>
            <span class="badge"><Icon name={mission.icon} /></span>
            <h3>{mission.title}</h3>
            <p>{mission.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section calendar" id="candidater">
    <div class="wrap calendar__grid">
      <div class="calendar__intro">
        <p class="eyebrow eyebrow--light">Calendrier des candidatures</p>
        <h2>Deux périodes pour rejoindre <span class="accent--light">la promotion 2027.</span></h2>
        <p>
          Choisissez la période correspondant au parcours de votre trotteur. La première phase
          est réservée aux chevaux confiés ou adoptés par l’intermédiaire du réseau Passerelle.
        </p>
      </div>

      <ol class="periods">
        <li class="periods__item periods__item--current">
          <span class="periods__number">01</span>
          <div>
            <p class="periods__status">Candidatures ouvertes</p>
            <h3>Jusqu’à mi-novembre 2026</h3>
            <p>Pour les propriétaires d’un trotteur issu du réseau Passerelle.</p>
          </div>
        </li>
        <li class="periods__item">
          <span class="periods__number">02</span>
          <div>
            <p class="periods__status">Deuxième phase</p>
            <h3>De mi-novembre à mi-décembre 2026</h3>
            <p>Pour les propriétaires d’un trotteur hors réseau Passerelle.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <CtaBand
    text="Prêt à faire connaître votre histoire ?"
    accent="Candidatez pour devenir ambassadeur 2027."
    label="Candidater"
    href={applicationUrl}
    external
    icon="users"
    note="Sélectionnez dans le formulaire la situation correspondant au parcours de votre trotteur."
  />
</Base>

<style>
  .programme__intro {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1.2fr);
    column-gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }
  .programme__intro .eyebrow,
  .programme__intro h2 {
    grid-column: 1;
  }
  .programme__intro > p:not(.eyebrow) {
    grid-column: 2;
    grid-row: 1 / span 2;
    margin: 0;
    color: var(--ink-soft);
  }
  .missions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .missions li {
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--cream-warm);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .missions .badge {
    width: 46px;
    height: 46px;
    margin-bottom: 1.4rem;
    background: color-mix(in srgb, var(--sage) 34%, var(--cream));
    color: var(--forest);
  }
  .missions .badge :global(svg) {
    width: 21px;
    height: 21px;
  }
  .missions p {
    margin: 0.7rem 0 0;
    color: var(--ink-soft);
    font-size: 0.94rem;
  }
  .calendar {
    color: #fff;
    background: var(--forest-deep);
  }
  .calendar__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(22rem, 1.2fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }
  .calendar__intro h2 {
    color: #fff;
  }
  .calendar__intro > p:not(.eyebrow) {
    margin: 1.2rem 0 0;
    color: rgba(255, 255, 255, 0.76);
  }
  .periods {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .periods__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.2rem;
    padding: clamp(1.2rem, 2.5vw, 1.6rem);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.04);
  }
  .periods__item--current {
    background: rgba(186, 214, 136, 0.1);
    border-color: rgba(186, 214, 136, 0.42);
  }
  .periods__number {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    color: var(--forest-deep);
    background: var(--sage);
    border-radius: 50%;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .periods__status {
    margin: 0 0 0.35rem;
    color: var(--sage);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .periods h3 {
    color: #fff;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
  }
  .periods__item div > p:last-child {
    margin: 0.45rem 0 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: 0.9rem;
  }

  @media (max-width: 800px) {
    .programme__intro,
    .calendar__grid {
      grid-template-columns: 1fr;
    }
    .programme__intro .eyebrow,
    .programme__intro h2,
    .programme__intro > p:not(.eyebrow) {
      grid-column: auto;
      grid-row: auto;
    }
    .programme__intro > p:not(.eyebrow) {
      margin-top: 1.2rem;
    }
    .missions {
      grid-template-columns: 1fr;
    }
  }
</style>
