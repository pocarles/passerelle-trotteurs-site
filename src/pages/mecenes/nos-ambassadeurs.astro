---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { ambassadeurs } from "../../data/mecenes";
---

<Base
  title="Nos ambassadeurs — Association Passerelle"
  description="Les ambassadeurs Passerelle racontent la reconversion des Trotteurs Français au quotidien."
>
  <PageHeader
    eyebrow="Ils nous soutiennent"
    title="Nos ambassadeurs,"
    accent="la reconversion vécue au quotidien."
    lead="Ils font connaître les multiples vies possibles après les courses, à travers les liens uniques qu’ils tissent avec leur trotteur."
    image="/media/ambassadeurs/darling-1.jpg"
    imageAlt="Jade et Darling des Mares, ambassadrices Passerelle"
  />

  <section class="recruitment" aria-labelledby="recruitment-title">
    <div class="wrap">
      <div class="recruitment__panel">
        <div class="recruitment__copy">
          <p class="eyebrow">Campagne 2027</p>
          <h2 id="recruitment-title">Devenez ambassadeur de la reconversion.</h2>
          <p>
            Vous partagez le quotidien d’un trotteur réformé&nbsp;? Faites rayonner son histoire
            et rejoignez le programme des ambassadeurs Passerelle en 2027.
          </p>
        </div>
        <div class="recruitment__dates" aria-label="Périodes de candidature">
          <p><strong>Jusqu’à mi-novembre</strong><span>Trotteurs issus du réseau Passerelle</span></p>
          <p><strong>Mi-novembre → mi-décembre</strong><span>Trotteurs hors réseau Passerelle</span></p>
        </div>
        <div class="recruitment__actions">
          <a
            class="recruitment__application recruitment__application--active"
            href="https://forms.gle/kzGNk5qNMoY6XqgC9"
            target="_blank"
            rel="noreferrer"
          >
            <span>
              <strong>Candidater</strong>
              <small>Trotteur issu du réseau Passerelle</small>
            </span>
            <span class="recruitment__application-icon"><Icon name="arrowUpRight" /></span>
          </a>
          <button
            class="recruitment__application recruitment__application--disabled"
            type="button"
            disabled
          >
            <span>
              <strong>Candidater</strong>
              <small>Trotteur hors réseau Passerelle</small>
            </span>
            <span class="recruitment__soon">Bientôt</span>
          </button>
          <a class="tlink" href="/mecenes/devenir-ambassadeur">
            Découvrir le programme
            <Icon name="arrow" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section amb">
    <div class="wrap">
      <p class="eyebrow eyebrow--light">Des histoires à partager</p>
      <h2>
        Des binômes qui racontent <span class="accent--light">ce que devient un trotteur.</span>
      </h2>
      <p class="amb__lead">
        Nos ambassadeurs vivent la reconversion au quotidien et la font connaître bien au-delà du monde des courses. Tous partagent l’amour de cette race et la volonté d’en révéler au monde la polyvalence ainsi que l’extraordinaire capacité d’adaptation.
      </p>

      <ul class="amb__list">
        {
          ambassadeurs.map((a) => (
            <li>
              <a href={`/mecenes/${a.slug}`}>
                <div class="amb__media">
                  <img src={a.photo} alt={a.nom} loading="lazy" />
                </div>
                <div class="amb__copy">
                  <p class="amb__role">{a.role}</p>
                  <h3>{a.nom}</h3>
                  <p>{a.resume}</p>
                  <span class="tlink tlink--light">
                    Lire leur histoire
                    <Icon name="arrow" />
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    text="Vous souhaitez raconter l’histoire de votre trotteur ?"
    accent="Parlons-en."
    label="Nous contacter"
    href="/contact"
    icon="users"
  />
</Base>

<style>
  .recruitment {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    background: var(--cream);
  }
  .recruitment__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(16rem, 0.75fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.7rem, 4vw, 3rem);
    background: var(--cream-warm);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .recruitment__copy h2 {
    max-width: 18ch;
    color: var(--forest-deep);
    font-size: clamp(1.8rem, 3.3vw, 2.75rem);
  }
  .recruitment__copy > p:not(.eyebrow) {
    max-width: 60ch;
    margin: 1rem 0 0;
    color: var(--ink-soft);
  }
  .recruitment__dates {
    display: grid;
    align-content: center;
    gap: 0.7rem;
  }
  .recruitment__dates p {
    margin: 0;
    padding: 0.9rem 1rem;
    background: color-mix(in srgb, var(--sage) 16%, var(--cream));
    border-left: 3px solid var(--moss-mid);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .recruitment__dates strong,
  .recruitment__dates span {
    display: block;
  }
  .recruitment__dates strong {
    color: var(--forest);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .recruitment__dates span {
    margin-top: 0.2rem;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .recruitment__actions {
    display: flex;
    grid-column: 1 / -1;
    align-items: stretch;
    flex-wrap: wrap;
    gap: 1rem 1.35rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .recruitment__application {
    display: inline-flex;
    min-width: min(100%, 18.5rem);
    min-height: 4.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0.7rem 0.65rem 1.3rem;
    border: 1.5px solid transparent;
    border-radius: 999px;
    font: inherit;
    text-align: left;
  }
  .recruitment__application > span:first-child {
    display: grid;
    gap: 0.06rem;
  }
  .recruitment__application strong {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .recruitment__application small {
    font-size: 0.69rem;
    line-height: 1.35;
  }
  .recruitment__application--active {
    color: var(--forest-deep);
    background: var(--sage);
    transition: background 180ms ease, transform 180ms ease;
  }
  .recruitment__application--active:hover {
    background: #a6c879;
    transform: translateY(-1px);
  }
  .recruitment__application-icon {
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: 0 0 2rem;
    place-items: center;
    background: rgba(31, 61, 43, 0.12);
    border-radius: 50%;
  }
  .recruitment__application-icon :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }
  .recruitment__application--disabled {
    color: var(--ink-faint);
    background: #e8e6df;
    border-color: rgba(35, 35, 31, 0.08);
    cursor: not-allowed;
  }
  .recruitment__soon {
    padding: 0.28rem 0.48rem;
    color: #77776f;
    background: rgba(255, 255, 255, 0.54);
    border-radius: 999px;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .recruitment__actions .tlink {
    align-self: center;
  }
  .amb {
    background: var(--forest-deep);
    color: #fff;
  }
  .amb h2 {
    width: 100%;
    max-width: none;
    color: #fff;
    text-wrap: pretty;
  }
  .amb__lead {
    width: 100%;
    max-width: none;
    margin: 1.4rem 0 3rem;
    color: rgba(255, 255, 255, 0.78);
  }
  .amb__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .amb__list a {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.2rem, 2.5vw, 1.8rem);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    transition: background 0.2s ease;
  }
  .amb__list a:hover {
    background: rgba(255, 255, 255, 0.05);
  }
  .amb__media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
  }
  .amb__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .amb__role {
    margin: 0 0 0.6rem;
    color: var(--sage);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .amb__copy h3 {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
  }
  .amb__copy > p:not(.amb__role) {
    max-width: 46ch;
    margin: 0.9rem 0 1.5rem;
    color: rgba(255, 255, 255, 0.78);
  }

  @media (max-width: 760px) {
    .recruitment__panel {
      grid-template-columns: 1fr;
    }
    .recruitment__actions {
      grid-column: auto;
      align-items: flex-start;
    }
    .recruitment__application {
      width: 100%;
      min-width: 0;
    }
    .amb h2 .accent--light {
      display: block;
    }
    .amb__list a {
      grid-template-columns: 1fr;
    }
  }
</style>
