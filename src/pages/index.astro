---
import { getCollection } from "astro:content";
import { dateLabel } from "../data/dates";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import {
  site,
  links,
  stats,
  missionPillars,
  pathways,
  protections,
} from "../data/site";

const latestNews = (await getCollection("actualites"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const schema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: site.fullName,
  alternateName: "Passerelle Trotteurs",
  url: site.url,
  logo: `${site.url}/media/logo.png`,
  description:
    "Association reconnue d’intérêt général dédiée à la reconversion et à la protection à vie des Trotteurs Français réformés des courses.",
  foundingDate: "2020-12",
  areaServed: "FR",
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: "FR",
  },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: site.phone,
    email: site.email,
    contactType: "customer support",
    availableLanguage: "French",
  },
  sameAs: [links.facebook, links.instagram],
};
---

<Base
  title="Passerelle — La seconde vie des Trotteurs Français"
  description="Passerelle prend en charge, reconvertit et protège à vie les Trotteurs Français sortant des courses. Confier un cheval, adopter, soutenir ou rejoindre le réseau accrédité."
  hasHero
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero">
    <img class="hero__img" src="/media/hero-trotteurs.jpg" alt="" width="1920" height="1281" fetchpriority="high" />
    <div class="hero__scrim"></div>
    <div class="hero__in wrap">
      <p class="eyebrow eyebrow--light">
        Association loi 1901 reconnue d’intérêt général
      </p>
      <h1>
        Leur carrière s’arrête.<br />
        <span class="accent--light">Leur histoire continue.</span>
      </h1>
      <hr class="rule rule--light" />
      <p class="hero__lead">
        Passerelle prend en charge les Trotteurs Français sortant de la filière
        des courses, quels que soient leur âge et leur état de santé, les
        accompagne vers une seconde vie et les protège, sous contrat, pour le
        reste de leurs jours.
      </p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/confier">
          Nous confier un trotteur
          <span class="btn__ico"><Icon name="arrow" /></span>
        </a>
        <a class="btn btn--ghost-light" href="/adopter">
          Adopter un trotteur
          <span class="btn__ico"><Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════ MISSION ═══════════ -->
  <section class="section mission">
    <div class="mission__track" aria-hidden="true">
      <span class="mission__track-rail mission__track-rail--outer"></span>
      <span class="mission__track-rail mission__track-rail--middle"></span>
      <span class="mission__track-rail mission__track-rail--inner"></span>
      <span class="mission__track-runner mission__track-runner--one"></span>
      <span class="mission__track-runner mission__track-runner--two"></span>
      <span class="mission__track-runner mission__track-runner--three"></span>
    </div>
    <div class="wrap mission__grid">
      <div>
        <p class="eyebrow">Notre mission</p>
        <h2>
          Créer une véritable passerelle entre la piste<br />
          et <span class="accent">leur vie d’après.</span>
        </h2>
        <p class="lead mission__body">
          Créée en décembre 2020, Passerelle est une association officielle de
          la reconversion des chevaux de courses de Trot en France, soutenue par
          LeTROT (désormais Trotteur Français) depuis 2021. Elle réunit des
          professionnels des courses et des passionnés du cheval.
        </p>
        <a class="tlink" href="/association">
          En savoir plus sur l’association
          <Icon name="arrow" />
        </a>
      </div>

      <ul class="pillars">
        {
          missionPillars.map((p) => (
            <li>
              <span class="badge"><Icon name={p.icon} /></span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══════════ STATS ═══════════ -->
  <section class="stats" aria-label="Passerelle en chiffres">
    <div class="wrap stats__grid">
      {
        stats.map((s) => (
          <div class="stat">
            <Icon name={s.icon} class="stat__ico" />
            <p class="stat__value">{s.value}</p>
            <p class="stat__label">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ═══════════ NEWS ═══════════ -->
  <section class="section news">
    <div class="wrap">
      <div class="news__head">
        <div>
          <p class="eyebrow">Actualités</p>
          <h2>Sur le terrain</h2>
        </div>
        <a class="tlink" href="/actualites">
          Toutes les actualités
          <Icon name="arrow" />
        </a>
      </div>
      <ul class="news__list">
        {
          latestNews.map((n) => (
            <li>
              <a href={`/actualites/${n.id}`}>
                <time datetime={n.data.date.toISOString().slice(0, 10)}>
                  {dateLabel(n.data.date, n.data.dateLabel)}
                </time>
                <h3>{n.data.title}</h3>
                <Icon name="arrow" class="news__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══════════ PATHWAYS ═══════════ -->
  <section class="section pathways">
    <div class="wrap">
      <div class="pathways__head">
        <p class="eyebrow">Quatre façons d’agir</p>
        <h2>
          Aujourd’hui agissez à nos côtés pour offrir aux trotteurs<br />
          <span class="accent">la meilleure seconde vie possible</span>
        </h2>
      </div>

      <div class="cards">
        {
          pathways.map((p) => (
            <article class="card">
              <div class="card__media">
                <img src={p.image} alt={p.alt} loading="lazy" />
                <span class="badge card__badge"><Icon name={p.icon} /></span>
              </div>
              <div class="card__body">
                <h3>{p.title}</h3>
                <p>{p.body}</p>
                <a
                  class="tlink"
                  href={p.href}
                  target={p.external ? "_blank" : undefined}
                  rel={p.external ? "noreferrer" : undefined}
                >
                  Découvrir
                  <Icon name="arrow" />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ═══════════ THE CONTRACT ═══════════ -->
  <section class="section protect">
    <div class="protect__horse-track" aria-hidden="true">
      <img
        class="protect__horse"
        src="/media/trotting-horse.png"
        alt=""
        width="1536"
        height="1024"
      />
    </div>
    <div class="wrap protect__grid">
      <div class="protect__intro">
        <p class="eyebrow eyebrow--light">La protection Passerelle</p>
        <h2>
          Un contrat qui les suit<br />
          <span class="accent--light">toute leur vie.</span>
        </h2>
        <p class="protect__lead">
          Un cheval placé par Passerelle l’est toujours avec une attention
          particulière au profil de l’adoptant. Chaque adoption et chaque vente
          est encadrée par un contrat Passerelle qui engage l’acquéreur — et qui
          vaut pour le reste de la vie du cheval. Passerelle assure un suivi à
          vie du cheval pour une traçabilité garantie.
        </p>
      </div>

      <ol class="protect__list">
        {
          protections.map((p, i) => (
            <li>
              <span class="protect__num">{String(i + 1).padStart(2, "0")}</span>
              <span>{p}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═══════════ CAPACITY NOTICE ═══════════ -->
  <section class="section notice-sec">
    <div class="wrap">
      <div class="notice">
        <span class="notice__ico"><Icon name="info" /></span>
        <div>
          <h3>Nos capacités d’accueil sont actuellement limitées.</h3>
          <p>
            Nos structures sont saturées. Les chevaux peuvent être inscrits sur
            liste d’attente, sans garantie de délai. Passerelle peut également
            fournir un contrat protecteur pour encadrer un placement direct.
          </p>
        </div>
        <a class="btn btn--ghost" href="/contact">
          Nous contacter
          <span class="btn__ico"><Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════ CLOSING CTA ═══════════ -->
  <section class="cta-sec">
    <div class="wrap">
      <div class="cta">
        <span class="badge cta__badge"><Icon name="heart" /></span>
        <p class="cta__text">
          Professionnels ou passionnés, ils nous ont fait vibrer.{" "}
          <span class="accent">Nous leur devons bien cela.</span>
        </p>
        <a class="btn btn--primary" href={links.donate} target="_blank" rel="noreferrer">
          Faire un don
          <span class="btn__ico"><Icon name="arrow" /></span>
        </a>
      </div>
      <p class="cta__note">
        66 % du montant de votre don est déductible de vos impôts — 60 % pour les
        entreprises.
      </p>
    </div>
  </section>
</Base>

<style>
  /* ───────── hero ───────── */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(88vh, 780px);
    padding-block: clamp(11rem, 20vh, 14rem) clamp(3.5rem, 8vh, 6rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 44%;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to right,
        rgba(12, 24, 16, 0.86) 0%,
        rgba(12, 24, 16, 0.62) 42%,
        rgba(12, 24, 16, 0.12) 78%
      ),
      linear-gradient(to bottom, rgba(12, 24, 16, 0.55) 0%, transparent 32%);
  }
  .hero__in {
    color: #fff;
    max-width: 1200px;
  }
  .hero h1 {
    color: #fff;
    max-width: 15ch;
  }
  .rule--light {
    background: var(--sage);
  }
  .hero__lead {
    max-width: 46ch;
    font-size: clamp(1.05rem, 1.4vw, 1.18rem);
    line-height: 1.62;
    color: rgba(255, 255, 255, 0.86);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2.2rem;
  }

  /* ───────── mission ───────── */
  .mission {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 50% 52%, rgba(110, 139, 61, 0.055), transparent 61%),
      var(--cream);
  }
  .mission__track {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0.88;
  }
  .mission__track::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(87vw, 1080px);
    height: clamp(260px, 38vw, 460px);
    border-radius: 50%;
    background: linear-gradient(90deg, transparent, rgba(110, 139, 61, 0.04), transparent);
    transform: translate(-50%, -50%) rotate(-7deg);
  }
  .mission__track-rail {
    position: absolute;
    left: 50%;
    top: 50%;
    border: 1px solid rgba(31, 61, 43, 0.14);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-7deg);
  }
  .mission__track-rail--outer {
    width: min(95vw, 1180px);
    height: clamp(300px, 46vw, 560px);
  }
  .mission__track-rail--middle {
    width: min(89vw, 1100px);
    height: clamp(260px, 40vw, 480px);
    border-color: rgba(85, 112, 44, 0.23);
    border-style: dashed;
    animation: track-dash 5s ease-in-out infinite alternate;
  }
  .mission__track-rail--inner {
    width: min(82vw, 1010px);
    height: clamp(220px, 34vw, 410px);
    border-color: rgba(31, 61, 43, 0.11);
  }
  .mission__track-runner {
    position: absolute;
    z-index: 1;
    width: 11px;
    height: 11px;
    margin: -5.5px 0 0 -5.5px;
    border: 2px solid var(--cream);
    border-radius: 50%;
    background: var(--moss-mid);
    box-shadow: 0 0 0 4px rgba(110, 139, 61, 0.12), 0 4px 12px rgba(31, 61, 43, 0.2);
    offset-path: ellipse(43% 34% at 50% 50%);
    offset-rotate: 0deg;
    animation: track-run 18s linear infinite;
    will-change: offset-distance;
  }
  .mission__track-runner--two {
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    background: var(--forest);
    opacity: 0.74;
    offset-path: ellipse(39% 30% at 50% 50%);
    animation-duration: 24s;
    animation-delay: -8s;
  }
  .mission__track-runner--three {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--sage);
    opacity: 0.9;
    offset-path: ellipse(35% 26% at 50% 50%);
    animation-duration: 29s;
    animation-delay: -17s;
  }
  .mission__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }
  .mission__body {
    margin: 1.6rem 0 2rem;
  }
  .pillars {
    display: grid;
    gap: 2.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pillars li {
    display: flex;
    gap: 1.4rem;
    align-items: flex-start;
  }
  .pillars h3 {
    margin-bottom: 0.4rem;
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .pillars p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
    max-width: 46ch;
  }

  /* ───────── stats ───────── */
  .stats {
    background: var(--forest);
    color: #fff;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .stat {
    text-align: center;
    padding-inline: 1rem;
  }
  .stat + .stat {
    border-left: 1px solid var(--line-light);
  }
  .stat__ico {
    width: 30px;
    height: 30px;
    margin: 0 auto 1.1rem;
    color: var(--sage);
  }
  .stat__value {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat__label {
    margin: 0.7rem 0 0;
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  /* ───────── pathways ───────── */
  .pathways__head {
    text-align: center;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.2rem, 2.4vw, 2rem);
  }
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 50px -30px rgba(35, 35, 31, 0.5);
  }
  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
  }
  /* Absolute so a portrait source can't stretch the card past its ratio. */
  .card__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__badge {
    position: absolute;
    left: 1.4rem;
    bottom: -27px;
    border: 4px solid var(--card);
    box-sizing: content-box;
  }
  .card__body {
    padding: 2.6rem 1.6rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    flex: 1;
  }
  .card__body h3 {
    font-family: var(--sans);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .card__body p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.97rem;
    flex: 1;
  }

  /* ───────── protection ───────── */
  .protect {
    position: relative;
    overflow: hidden;
    background: var(--forest-deep);
    color: #fff;
  }
  .protect__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
    padding-bottom: clamp(3.5rem, 5vw, 4.75rem);
  }
  .protect__horse-track {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0.75rem;
    left: 0;
    height: clamp(4.5rem, 7vw, 6.2rem);
    overflow: hidden;
    pointer-events: none;
  }
  .protect__horse-track::before {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0.45rem;
    left: 0;
    height: 1px;
    background: rgba(186, 214, 136, 0.22);
  }
  .protect__horse {
    position: absolute;
    bottom: 0.18rem;
    left: 0;
    width: clamp(112px, 10vw, 152px);
    height: auto;
    max-width: none;
    filter: drop-shadow(0 3px 4px rgba(8, 22, 13, 0.2));
    animation: protect-horse-run 18s linear infinite;
    will-change: transform;
  }
  .protect h2 {
    color: #fff;
  }
  .protect__lead {
    margin: 1.6rem 0 2rem;
    color: rgba(255, 255, 255, 0.78);
    max-width: 42ch;
  }
  .protect__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--line-light);
    border: 1px solid var(--line-light);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .protect__list li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.5rem 1.4rem;
    background: var(--forest-deep);
    font-size: 0.97rem;
    line-height: 1.5;
  }
  .protect__num {
    font-family: var(--serif);
    font-size: 0.95rem;
    color: var(--sage);
    flex: 0 0 auto;
  }

  /* ───────── notice ───────── */
  .notice-sec {
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .notice {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 3vw, 2.4rem);
    padding: clamp(1.6rem, 3vw, 2.2rem);
    background: var(--cream-warm);
    border: 1px solid var(--line);
    border-left: 3px solid var(--moss-mid);
    border-radius: var(--radius);
  }
  .notice__ico {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: var(--moss);
  }
  .notice__ico :global(svg) {
    width: 30px;
    height: 30px;
  }
  .notice h3 {
    font-family: var(--sans);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0;
    margin-bottom: 0.35rem;
  }
  .notice p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
    max-width: 62ch;
  }
  .notice .btn {
    flex: 0 0 auto;
  }

  /* ───────── news ───────── */
  .news {
    background: var(--cream-warm);
    border-block: 1px solid var(--line);
  }
  .news__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .news__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .news__list a {
    display: grid;
    grid-template-columns: 170px 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
    transition: padding-inline 0.2s ease;
  }
  .news__list a:hover {
    padding-inline: 0.75rem;
  }
  .news__list time {
    color: var(--moss);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .news__list h3 {
    font-size: 1.28rem;
  }
  .news__arrow {
    width: 17px;
    height: 17px;
    color: var(--ink-faint);
  }

  /* ───────── closing CTA ───────── */
  .cta-sec {
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }
  .cta {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 3vw, 2.5rem);
    padding: clamp(1.4rem, 2.5vw, 1.8rem) clamp(1.4rem, 2.5vw, 2rem);
    background: var(--cream-warm);
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .cta__badge {
    background: var(--sage);
    color: var(--forest-deep);
  }
  .cta__text {
    flex: 1;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .cta .btn {
    flex: 0 0 auto;
  }
  .cta__note {
    margin: 1.2rem auto 0;
    text-align: center;
    color: var(--ink-faint);
    font-size: 0.85rem;
  }

  @keyframes track-run {
    from {
      offset-distance: 0%;
