---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { links } from "../../data/site";

const all = (await getCollection("actualites")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const [featured, ...rest] = all;

const byYear = new Map<number, typeof rest>();
for (const a of rest) {
  const y = a.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(a);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base
  title="Actualités — Association Passerelle"
  description="Les actions, événements et partenariats de l’Association Passerelle en faveur de la reconversion des Trotteurs Français."
>
  <PageHeader
    eyebrow="Journal"
    title="Sur le terrain,"
    accent="depuis 2021."
    lead={`${all.length} articles : hippodromes, salons, communiqués et rencontres qui font avancer la reconversion des Trotteurs Français.`}
  />

  {
    featured && (
      <section class="section feat-sec">
        <div class="wrap">
          <a class="feat" href={`/actualites/${featured.id}`}>
            {featured.data.image && (
              <div class="feat__media">
                <img src={featured.data.image} alt="" loading="eager" />
              </div>
            )}
            <div class="feat__copy">
              <p class="eyebrow">À la une</p>
              <h2>{featured.data.title}</h2>
              <p class="feat__meta">
                <time datetime={featured.data.date.toISOString().slice(0, 10)}>
                  {featured.data.dateLabel}
                </time>
                {featured.data.source && <span>· {featured.data.source}</span>}
              </p>
              <span class="tlink">
                Lire l’article
                <Icon name="arrow" />
              </span>
            </div>
          </a>
        </div>
      </section>
    )
  }

  <section class="section archive">
    <div class="wrap">
      {
        years.map((year) => (
          <div class="year">
            <h2 class="year__label">{year}</h2>
            <ul class="list">
              {byYear.get(year)!.map((a) => (
                <li>
                  <a href={`/actualites/${a.id}`}>
                    <time datetime={a.data.date.toISOString().slice(0, 10)}>
                      {a.data.dateLabel}
                    </time>
                    <h3>{a.data.title}</h3>
                    <Icon name="arrow" class="list__arrow" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <CtaBand
    text="Vous organisez une journée sur un hippodrome&nbsp;?"
    accent="Invitez Passerelle."
    label="Nous contacter"
    href="/contact"
    icon="users"
    note={`Retrouvez aussi nos actions au jour le jour sur Facebook et Instagram.`}
  />
</Base>

<style>
  .feat-sec {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .feat {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(1.2rem, 2.5vw, 1.8rem);
    background: var(--cream-warm);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .feat:hover {
    transform: translateY(-3px);
    box-shadow: 0 26px 50px -32px rgba(35, 35, 31, 0.5);
  }
  .feat__media {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .feat__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .feat h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.35rem);
  }
  .feat__meta {
    margin: 0.9rem 0 1.4rem;
    color: var(--ink-faint);
    font-size: 0.82rem;
  }

  .archive {
    padding-top: 0;
  }
  .year + .year {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .year__label {
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
    color: var(--moss);
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .list a {
    display: grid;
    grid-template-columns: 170px 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
    transition: padding-inline 0.2s ease;
  }
  .list a:hover {
    padding-inline: 0.75rem;
  }
  .list time {
    color: var(--moss);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .list h3 {
    font-size: 1.22rem;
  }
  .list__arrow {
    width: 17px;
    height: 17px;
    color: var(--ink-faint);
  }

  @media (max-width: 900px) {
    .feat {
      grid-template-columns: 1fr;
    }
    .list a {
      grid-template-columns: 1fr auto;
    }
    .list time {
      grid-column: 1 / -1;
    }
  }
</style>
