---
import { getCollection, render } from "astro:content";
import { dateLabel } from "../../data/dates";
import Base from "../../layouts/Base.astro";
import Prose from "../../components/Prose.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const all = (await getCollection("actualites")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i + 1], next: all[i - 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);

/** First 22 words of the body, tags stripped, for the meta description. */
const description =
  entry.body
    ?.replace(/<[^>]+>/g, " ")
    .replace(/&[a-z#0-9]+;/gi, " ")
    .replace(/\s+/g, " ")
    .trim()
    .split(" ")
    .slice(0, 32)
    .join(" ") + "…";
const publishedTime = entry.data.date.toISOString().slice(0, 10);
const articleUrl = `${site.url}/actualites/${entry.id}`;
const articleImage = entry.data.image
  ? new URL(entry.data.image, site.url).href
  : `${site.url}/media/hero-trotteurs.jpg`;

const schema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "@id": `${articleUrl}/#article`,
  headline: entry.data.title,
  description,
  datePublished: publishedTime,
  inLanguage: "fr-FR",
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  image: articleImage,
  author: entry.data.source
    ? { "@type": "Organization", name: entry.data.source }
    : { "@id": `${site.url}/#organization` },
  publisher: {
    "@type": "Organization",
    "@id": `${site.url}/#organization`,
    name: site.fullName,
    url: site.url,
    logo: {
      "@type": "ImageObject",
      url: `${site.url}/media/logo.png`,
    },
  },
};
---

<Base
  title={`${entry.data.title} — Passerelle`}
  description={description}
  image={entry.data.image}
  imageAlt={entry.data.title}
  type="article"
  publishedTime={publishedTime}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article>
    <header class="head">
      <div class="wrap">
        <a class="tlink back" href="/actualites">
          <Icon name="arrow" class="back__ico" />
          Toutes les actualités
        </a>
        <h1>{entry.data.title}</h1>
        <p class="meta">
          <time datetime={entry.data.date.toISOString().slice(0, 10)}>
            {dateLabel(entry.data.date, entry.data.dateLabel)}
          </time>
          {entry.data.source && <span>· Source&nbsp;: {entry.data.source}</span>}
        </p>
      </div>
    </header>

    {
      entry.data.image && (
        <figure class="hero-img">
          <div class="wrap">
            <img src={entry.data.image} alt={entry.data.title} loading="eager" decoding="async" />
          </div>
        </figure>
      )
    }

    <div class="section body">
      <div class="wrap">
        <Prose>
          <Content />
        </Prose>
      </div>
  </div>
</article>

  <CtaBand
    text="Suivez l’Hippodrome de Lannemezan."
    accent="Retrouvez leurs actualités sur Facebook."
    label="Voir la page Facebook"
    href="https://www.facebook.com/profile.php?id=61590792746490"
    external
  />

  <nav class="pager" aria-label="Navigation entre articles">
    <div class="wrap pager__in">
      {
        prev ? (
          <a href={`/actualites/${prev.id}`} class="pager__link pager__link--prev">
            <span>Article précédent</span>
            <strong>{prev.data.title}</strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={`/actualites/${next.id}`} class="pager__link pager__link--next">
            <span>Article suivant</span>
            <strong>{next.data.title}</strong>
          </a>
        )
      }
    </div>
  </nav>

</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .head .wrap {
    max-width: 860px;
  }
  .back {
    margin-bottom: 2rem;
  }
  .back__ico {
    transform: rotate(180deg);
  }
  .head h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    max-width: 22ch;
  }
  .meta {
    margin: 1.2rem 0 0;
    color: var(--ink-faint);
    font-size: 0.85rem;
  }
  .meta time {
    color: var(--moss);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.75rem;
  }

  .hero-img {
    margin: 0 0 clamp(2rem, 4vw, 3rem);
  }
  .hero-img .wrap {
    max-width: 1000px;
  }
  .hero-img img {
    width: 100%;
    max-height: 620px;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .body {
    padding-top: 0;
  }
  .body .wrap {
    max-width: 860px;
  }

  .pager {
    border-top: 1px solid var(--line);
    background: var(--cream-warm);
  }
  .pager__in {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    padding: 0;
  }
  .pager__link {
    display: block;
    padding: clamp(1.6rem, 3vw, 2.4rem) var(--gutter);
    transition: background 0.2s ease;
  }
  .pager__link:hover {
    background: var(--cream);
  }
  .pager__link--next {
    text-align: right;
    border-left: 1px solid var(--line);
  }
  .pager__link span {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--moss);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .pager__link strong {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.3;
  }

  @media (max-width: 720px) {
    .pager__in {
      grid-template-columns: 1fr;
    }
    .pager__link--next {
      text-align: left;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>

<style is:global>
  /* Ported bodies carry their own images and captions. */
  .prose img {
    width: 100%;
    height: auto;
    margin: 2rem 0;
    border-radius: var(--radius);
  }
  .prose p:has(img) + p {
    margin-top: -1.2rem;
    color: var(--ink-faint);
    font-size: 0.85rem;
  }
  .prose .article-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: none;
    margin: 2rem 0;
  }
  .prose .article-gallery figure {
    min-width: 0;
    margin: 0;
  }
  .prose .article-gallery img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }
  .prose .article-gallery figcaption {
    margin-top: 0.55rem;
    color: var(--ink-faint);
    font-size: 0.8rem;
    line-height: 1.35;
  }
  @media (max-width: 620px) {
    .prose .article-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
