---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Prose from "../components/Prose.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import { links } from "../data/site";

const profiles = [
  {
    title: "Yearlings & jeunes chevaux",
    body: "Poulains et pouliches non qualifiés.",
  },
  {
    title: "Chevaux sortants du circuit course",
    body: "Chevaux non performants ou blessés.",
  },
  {
    title: "Poulinières",
    body: "Poulinières sortant de la reproduction.",
  },
];
---

<Base
  title="Confier un Trotteur Français — Association Passerelle"
  description="Propriétaires, entraîneurs et éleveurs : déposez une demande de prise en charge pour un Trotteur Français sortant de la filière course."
>
  <PageHeader
    eyebrow="Confier un trotteur"
    title="De la filière course"
    accent="vers une seconde vie."
    lead="Passerelle prend en charge les Trotteurs Français en amont et en aval de la filière hippique du trot, sans discrimination d’âge ou d’état de santé."
    image="/media/stable.jpg"
    imageAlt="Une bénévole Passerelle auprès d’un trotteur dans son box"
  />

  <section class="section profiles-sec">
    <div class="wrap">
      <p class="eyebrow">Propriétaires · Entraîneurs · Éleveurs</p>
      <h2 class="profiles__title">Pour quels chevaux&nbsp;?</h2>
      <ul class="profiles">
        {
          profiles.map((profile) => (
            <li>
              <span class="badge"><Icon name="horse" /></span>
              <h3>{profile.title}</h3>
              <p>{profile.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="notice-sec">
    <div class="wrap">
      <div class="notice">
        <span class="notice__ico"><Icon name="info" /></span>
        <div>
          <h3>Nos capacités d’accueil sont actuellement limitées.</h3>
          <p>
            Nos structures sont saturées. Les chevaux peuvent être inscrits sur
            liste d’attente, sans garantie de délai. Passerelle peut également
            fournir un contrat protecteur pour encadrer un placement direct.
          </p>
        </div>
        <a class="btn btn--ghost" href="/contact">
          Nous contacter
          <span class="btn__ico"><Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section process">
    <div class="wrap process__grid">
      <div>
        <p class="eyebrow eyebrow--light">La prise en charge</p>
        <h2>Nous organisons <span class="accent--light">chaque étape.</span></h2>
      </div>
      <Prose>
        <p>
          En fonction du profil de votre cheval&nbsp;: âge, montable ou non,
          sain ou convalescent, nous reprenons votre cheval en fonction d’une
          grille tarifaire pré-établie.
        </p>
        <p>
          Nous nous engageons à trouver une structure d’accueil affiliée
          Passerelle dans les plus brefs délais.
        </p>
        <p>
          Nous prenons en charge l’ensemble des démarches administratives et
          nous organisons le transport afin de vous soulager.
        </p>

        <h3>Déposer votre demande</h3>
        <p>
          Afin de faciliter la prise en charge, veuillez créer un compte et vous
          connecter sur notre plateforme dédiée aux prises en charge des
          chevaux.
        </p>
        <p>
          Pour rappel&nbsp;: Passerelle ne peut prendre en charge que des
          chevaux Trotteurs Français sortant de la filière course.
        </p>
        <p>
          Vous devez être en possession du carnet et de la carte de propriétaire
          pour le départ du cheval.
        </p>
      </Prose>
    </div>
  </section>

  <CtaBand
    text="Créez votre compte pour"
    accent="déposer une demande de prise en charge."
    label="Déposer une demande"
    href={links.intake}
    external
    icon="hand"
  />
</Base>

<style>
  .profiles__title {
    margin-bottom: 3rem;
  }
  .profiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.8rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .profiles h3 {
    margin: 1.2rem 0 0.5rem;
  }
  .profiles p {
    margin: 0;
    color: var(--ink-soft);
  }
  .notice-sec {
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .notice {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 3vw, 2.4rem);
    padding: clamp(1.6rem, 3vw, 2.2rem);
    border: 1px solid var(--line);
    border-left: 3px solid var(--moss-mid);
    border-radius: var(--radius);
    background: var(--cream-warm);
  }
  .notice__ico {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: var(--moss);
  }
  .notice__ico :global(svg) {
    width: 30px;
    height: 30px;
  }
  .notice h3 {
    margin-bottom: 0.35rem;
    font-family: var(--sans);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .notice p {
    max-width: 62ch;
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .notice .btn {
    flex: 0 0 auto;
  }
  .process {
    background: var(--forest-deep);
    color: #fff;
  }
  .process__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2.5rem, 7vw, 6rem);
  }
  .process h2,
  .process :global(.prose h3) {
    color: #fff;
  }
  .process :global(.prose p) {
    color: rgba(255, 255, 255, 0.78);
  }

  @media (max-width: 820px) {
    .profiles,
    .process__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 720px) {
    .notice {
      flex-direction: column;
      align-items: flex-start;
      border-radius: var(--radius-lg);
    }
  }
</style>
