---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import CtaBand from "../../components/CtaBand.astro";
import { links } from "../../data/site";

const team = [
  {
    name: "Aurélie Malet",
    initials: "AM",
    role: "Directrice et Fondatrice — Délégation Nord",
    image: "/media/team-aurelie.jpg?v=portraits-20260805",
    bio: [
      "Aurélie est attachée aux animaux depuis sa plus tendre enfance. Elle a toujours été très sensible à la cause animale et à la place de ces derniers dans notre société. La passion des chevaux et l’attachement à ces grands compagnons s’est faite naturellement très rapidement. Cavalière depuis ses 10 ans, les chevaux n’ont cessé de l’accompagner tout au long de sa vie. Propriétaire de six chevaux, Aurélie est également proche des professionnels soignants.",
      "Elle a su se faire une place dans le monde du Trot dont elle n’était pas issue et travaille désormais main dans la main avec les propriétaires, éleveurs, entraîneurs et autres socio-professionnels de cette filière.",
    ],
  },
  {
    name: "Floriane",
    initials: "F",
    role: "Présidente & aide au développement du réseau de socioprofessionnels",
    image: "/media/team-floriane.jpg?v=portraits-20260805",
    bio: [
      "Floriane a commencé à monter à poney à l’âge de 6 ans et depuis les chevaux ne l’ont jamais quittée. À 16 ans, elle est partie étudier en MFR où elle a obtenu un BEPA et un Bac Pro Production Animale en alternance entre l’école à Avranches et Granville et les stages dans différentes écuries. À l’issue de sa formation, elle a travaillé dans des haras.",
      "Responsable d’un élevage de trotteurs, elle participe au développement de l’association en la faisant connaître auprès des différents professionnels qu’elle côtoie dans son métier.",
    ],
  },
  {
    name: "Méline Brigand",
    initials: "MB",
    role: "Assistante de direction — Délégation Sud",
    image: "/media/team-meline.jpg?v=portraits-20260805",
    bio: [
      "Méline termine des études en management et gestion dans la filière équine. Déjà titulaire d’une licence de droit et d’un master en relations internationales, elle a fait le choix de se réorienter vers sa passion depuis toujours : les chevaux.",
      "Cavalière d’équitation classique et notamment de Dressage, elle a découvert les trotteurs sur son parcours équestre et en est tombée amoureuse. Elle seconde la présidente dans la gestion de l’association, sur les volets administratif, communication et événementiel.",
    ],
  },
];
---

<Base
  title="L’équipe — Association Passerelle"
  description="Découvrez les trois membres de l’équipe Passerelle engagées pour la reconversion et la protection des Trotteurs Français."
>
  <PageHeader
    eyebrow="L’association"
    title="L’équipe Passerelle,"
    accent="un même engagement."
    lead="L’équipe de Passerelle réunit une expérience de terrain, une connaissance de la filière équine et de la filière des courses, ainsi qu’un engagement en faveur du bien-être équin avant, pendant et après les courses."
  />

  <section class="section">
    <div class="wrap team">
      {
        team.map((person) => (
          <article class:list={["person", person.name === "Floriane" && "person--floriane"]}>
            <div class:list={["person__media", !person.image && "person__media--fallback"]}>
              {person.image ? (
                <img src={person.image} alt={`Portrait de ${person.name}`} loading="lazy" />
              ) : (
                <span aria-hidden="true">{person.initials}</span>
              )}
            </div>
            <div class="person__copy">
              <p class="eyebrow">{person.role}</p>
              <h2>{person.name}</h2>
              {person.bio.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand
    text="Chaque adhésion aide l’équipe à poursuivre sa mission."
    accent="Rejoignez-nous."
    label="Adhérer"
    href={links.join}
    external
    icon="users"
  />
</Base>

<style>
  .team {
    display: grid;
    gap: clamp(4rem, 9vw, 7rem);
  }
  .person {
    display: grid;
    grid-template-columns: minmax(240px, 0.72fr) 1.28fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .person--floriane {
    grid-template-columns: minmax(220px, 0.66fr) 1.34fr;
  }
  .person:nth-child(even) .person__media {
    order: 2;
  }
  .person__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--forest);
  }
  .person__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .person__media--fallback {
    display: grid;
    place-items: center;
    background: var(--forest);
    color: var(--sage);
  }
  .person__media--fallback span {
    font-family: var(--serif);
    font-size: clamp(4rem, 9vw, 7rem);
    font-style: italic;
  }
  .person__copy {
    max-width: 64ch;
    padding-top: 0.7rem;
  }
  .person__copy .eyebrow {
    line-height: 1.55;
  }
  .person__copy h2 {
    margin-bottom: 1.6rem;
  }
  .person__copy p:not(.eyebrow) {
    color: var(--ink-soft);
  }

  @media (max-width: 760px) {
    .person {
      grid-template-columns: 1fr;
    }
    .person:nth-child(even) .person__media {
      order: 0;
    }
    .person__media {
      max-width: 420px;
    }
  }
</style>
