---
import { getCollection } from "astro:content";
import { dateLabel } from "../../data/dates";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Prose from "../../components/Prose.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { links, stats, missionPillars } from "../../data/site";

const latestNews = (await getCollection("actualites"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const objectifs = [
  "Sensibiliser le grand public et les acteurs de la filière hippique aux enjeux de la reconversion.",
  "Faciliter le placement des chevaux réformés.",
  "Accompagner éleveurs, propriétaires et entraîneurs dans la revalorisation de leurs chevaux, en garantissant un suivi tout au long de la vie du cheval.",
  "Développer le réseau des structures qui accueillent les trotteurs pour les désensibiliser et leur redonner les codes de l’équitation classique.",
  "Promouvoir la polyvalence des trotteurs réformés vers d’autres disciplines équestres ou comme chevaux de compagnie.",
  "Trouver les fonds nécessaires au développement de l’association.",
];

const values = [
  {
    title: "Engagement",
    body: "Passerelle et ses structures sont impliquées auprès de la filière et connaissent le monde des courses hippiques de trot.",
    linkText: "",
    linkHref: "",
  },
  {
    title: "Protection",
    body: "Passerelle protège et suit à vie les chevaux pris en charge notamment grâce à nos contrats protecteurs.",
    linkText: "",
    linkHref: "",
  },
  {
    title: "Respect du Cheval",
    body: "L’association et ses structures s’engagent à respecter la ",
    linkText: "Charte du bien être équin",
    linkHref: "https://respe.net/wp-content/uploads/2019/02/charte-pour-le-bien-etre-equin-signee-160304.pdf",
  },
];
---

<Base
  title="Association — Association Passerelle"
  description="Découvrez les missions, les engagements et les valeurs de l’Association Passerelle pour la reconversion et la protection à vie des Trotteurs Français."
>
  <PageHeader
    eyebrow="L’association"
    title="Créer une véritable passerelle entre la piste"
    accent="et leur vie d’après."
    lead="Passerelle prend en charge les Trotteurs Français sortant des courses, les accompagne vers une seconde vie et les protège, sous contrat, pour le reste de leurs jours."
    image="/media/association-trotteurs.jpg"
    imageAlt="Des Trotteurs Français attelés sur une piste de course"
    background
  />

  <section class="section association-intro">
    <div class="wrap">
      <Prose width="wide">
        <p>
          Créée en décembre 2020, Passerelle est une association officielle de
          la reconversion des chevaux de courses de Trot en France, soutenue par{" "}
          <a href="https://www.letrot.com/" target="_blank" rel="noreferrer">LeTROT</a>{" "}
          (désormais Trotteur Français) depuis 2021. Elle réunit des
          professionnels des courses et des passionnés du cheval.
        </p>

        <blockquote class="reason-quote">
          <p>
            Tout simplement parce qu’issus de la filière ou passionnés, les
            chevaux, vous les aimez. Pour certains d’entre vous, vous les avez
            faits naître, les avez élevés puis entraînés. Que l’on soit
            professionnel ou non, ils vous ont fait vibrer. Vous avez partagé
            vos joies et vos peines avec eux. Alors peu importe leurs gains :
            vous, nous, leur devons bien cela.
          </p>
        </blockquote>
      </Prose>

      <div class="association-actions">
        <p class="eyebrow">Comment nous agissons</p>
        <h2 class="sec-title">Trois engagements, du premier appel à la fin de leur vie.</h2>
        <ul class="pillars">
          {
            missionPillars.map((p) => (
              <li>
                <span class="badge"><Icon name={p.icon} /></span>
                <div>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <Prose width="wide">

        <h2 id="objectifs" class="values-heading objectives-heading">Nos objectifs</h2>
        <ol class="objectives-grid">
          {
            objectifs.map((objective, index) => (
              <li>
                <span class="objectives-grid__number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <p>{objective}</p>
              </li>
            ))
          }
        </ol>

        <h2 id="valeurs" class="values-heading">Nos valeurs</h2>
        <ul class="values-grid">
          {
            values.map((value, index) => (
              <li>
                <span class="values-grid__number" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3>{value.title}</h3>
                <p>
                  {value.body}
                  {value.linkText && (
                    <a href={value.linkHref} target="_blank" rel="noreferrer">
                      {value.linkText}
                    </a>
                  )}
                  {value.linkText && "."}
                </p>
              </li>
            ))
          }
        </ul>
      </Prose>
    </div>
  </section>

  <section class="stats" aria-label="Passerelle en chiffres">
    <div class="wrap stats__grid">
      {
        stats.map((s) => (
          <div class="stat">
            <Icon name={s.icon} class="stat__ico" />
            <p class="stat__value">{s.value}</p>
            <p class="stat__label">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section association-news">
    <div class="wrap">
      <div class="association-news__head">
        <div>
          <p class="eyebrow">Actualités</p>
          <h2>Sur le terrain</h2>
        </div>
        <a class="tlink" href="/actualites">
          Toutes les actualités
          <Icon name="arrow" />
        </a>
      </div>
      <ul class="association-news__list">
        {
          latestNews.map((article) => (
            <li>
              <a href={`/actualites/${article.id}`}>
                <time datetime={article.data.date.toISOString().slice(0, 10)}>
                  {dateLabel(article.data.date, article.data.dateLabel)}
                </time>
                <h3>{article.data.title}</h3>
                <Icon name="arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    text="Chaque adhésion et chaque don participe directement à la reconversion d’un cheval."
    accent="Rejoignez-nous."
    label="Adhérer"
    href={links.join}
    external
    note="66 % du montant de votre don est déductible de vos impôts — 60 % pour les entreprises."
  />
</Base>

<style>
  .association-intro {
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }

  :global(.prose blockquote.reason-quote) {
    margin-top: clamp(2rem, 4vw, 3rem);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    line-height: 1.45;
    letter-spacing: 0.01em;
  }

  .stats {
    background: var(--forest);
    color: #fff;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .stat {
    text-align: center;
    padding-inline: 1rem;
  }
  .stat + .stat {
    border-left: 1px solid var(--line-light);
  }
  .stat__ico {
    width: 30px;
    height: 30px;
    margin: 0 auto 1.1rem;
    color: var(--sage);
  }
  .stat__value {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat__label {
    margin: 0.7rem 0 0;
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  .association-news {
    background: var(--cream-warm);
    border-block: 1px solid var(--line);
  }
  .association-news__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .association-news__head h2 {
    margin-bottom: 0;
  }
  .association-news__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .association-news__list a {
    display: grid;
    grid-template-columns: 170px 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
    transition: padding-inline 0.2s ease;
  }
  .association-news__list a:hover {
    padding-inline: 0.75rem;
  }
  .association-news__list time {
    color: var(--moss);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .association-news__list h3 {
    margin: 0;
    font-size: 1.28rem;
  }
  .association-news__list :global(svg) {
    width: 17px;
    height: 17px;
    color: var(--ink-faint);
  }

  .sec-title {
    max-width: 20ch;
    margin-bottom: 3rem;
  }
  .association-actions {
    margin-block: clamp(3.5rem, 7vw, 6.5rem);
  }
  .values-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 3.2rem 0 0;
    color: var(--moss);
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }
  .values-heading::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .objectives-heading {
    margin: 0;
  }
  .objectives-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin: 1.2rem 0 clamp(3.5rem, 6vw, 5.5rem);
    padding: 0;
    list-style: none;
  }
  :global(.prose ol.objectives-grid) {
    padding-left: 0;
  }
  .objectives-grid li {
    display: grid;
    grid-template-columns: 2.45rem minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    min-height: 7rem;
    padding: 1.15rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--sage) 17%, transparent);
  }
  :global(.prose ol.objectives-grid > li) {
    margin-top: 0;
    padding-left: 1.15rem;
  }
  :global(.prose ol.objectives-grid > li::before) {
    display: none;
    content: none;
  }
  .objectives-grid__number {
    display: grid;
    width: 2.45rem;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    background: var(--sage);
    color: var(--forest);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  :global(.prose) .objectives-grid p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.5;
  }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0 0 2.8rem;
    padding: 1.8rem 0 2.8rem;
    border-bottom: 1px solid var(--line);
    list-style: none;
  }
  .values-grid li {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-inline: clamp(1rem, 2.4vw, 2.4rem);
    text-align: center;
  }
  :global(.prose ul.values-grid > li) {
    margin-top: 0;
    padding-left: clamp(1rem, 2.4vw, 2.4rem);
  }
  :global(.prose ul.values-grid > li::before) {
    display: none;
    content: none;
  }
  .values-grid li + li {
    border-left: 1px solid var(--line);
  }
  .values-grid__number {
    color: var(--moss);
    font-family: var(--serif);
    font-size: 0.95rem;
    line-height: 1;
  }
  :global(.prose) .values-grid h3 {
    margin: 0.65rem 0 0.8rem;
    font-family: var(--serif);
    font-size: clamp(1.45rem, 2.5vw, 2.05rem);
    line-height: 1.1;
  }
  :global(.prose) .values-grid p {
    max-width: 24ch;
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.96rem;
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.8rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pillars li {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .pillars h3 {
    margin-bottom: 0.4rem;
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .pillars p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }
  @media (max-width: 960px) {
    .stats__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 0;
    }
    .stat:nth-child(3) {
      border-left: 0;
    }
    .association-news__list a {
      grid-template-columns: 1fr auto;
    }
    .association-news__list time {
      grid-column: 1 / -1;
    }
    .pillars {
      grid-template-columns: 1fr;
    }
    .objectives-grid {
      grid-template-columns: 1fr;
    }
    .values-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .values-grid li + li {
      padding-top: 2rem;
      border-top: 1px solid var(--line);
      border-left: 0;
    }
  }
</style>
