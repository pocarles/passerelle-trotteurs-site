---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Prose from "../../components/Prose.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { links, stats, missionPillars } from "../../data/site";

const objectifs = [
  "Sensibiliser le grand public et les acteurs de la filière hippique aux enjeux de la reconversion.",
  "Faciliter le placement des chevaux réformés.",
  "Accompagner éleveurs, propriétaires et entraîneurs dans la revalorisation de leurs chevaux, en garantissant un suivi tout au long de la vie du cheval.",
  "Développer le réseau des structures qui accueillent les trotteurs pour les désensibiliser et leur redonner les codes de l’équitation classique.",
  "Promouvoir la polyvalence des trotteurs réformés vers d’autres disciplines équestres ou comme chevaux de compagnie.",
  "Trouver les fonds nécessaires au développement de l’association.",
];

const values = [
  "Un engagement des structures de reconversion professionnelles affiliées.",
  "Protection à vie contre l’abattage, l’expérimentation animale et interdiction de reprise des courses.",
  "Le respect du cheval.",
];
---

<Base
  title="Association — Association Passerelle"
  description="Découvrez les missions, les engagements et les valeurs de l’Association Passerelle pour la reconversion et la protection à vie des Trotteurs Français."
>
  <PageHeader
    eyebrow="L’association"
    title="Créer une véritable passerelle entre la piste"
    accent="et leur vie d’après."
    lead="Passerelle prend en charge les Trotteurs Français sortant des courses, les accompagne vers une seconde vie et les protège, sous contrat, pour le reste de leurs jours."
    image="/media/racecare.jpg"
    imageAlt="Une cavalière et son trotteur lors d’une journée sur un hippodrome"
  />

  <section class="section">
    <div class="wrap">
      <Prose>
        <p>
          Créée en décembre 2020, Passerelle est une association officielle de
          la reconversion des chevaux de courses de Trot en France, soutenue par{" "}
          <a href="https://www.letrot.com/" target="_blank" rel="noreferrer">LeTROT</a>{" "}
          (désormais Trotteur Français) depuis 2021. Elle réunit des
          professionnels des courses et des passionnés du cheval.
        </p>

        <h2>Nos objectifs</h2>
        <ol>
          {objectifs.map((o) => <li>{o}</li>)}
        </ol>

        <h2>Notre raison d’être</h2>
        <blockquote>
          <p>
            Tout simplement parce qu’issus de la filière ou passionnés, les
            chevaux, vous les aimez. Pour certains d’entre vous, vous les avez
            faits naître, les avez élevés puis entraînés. Que l’on soit
            professionnel ou non, ils vous ont fait vibrer. Vous avez partagé
            vos joies et vos peines avec eux. Alors peu importe leurs gains :
            vous, nous, leur devons bien cela.
          </p>
        </blockquote>

        <h2 id="valeurs">Nos valeurs</h2>
        <ul class="opening">
          {values.map((value) => <li><strong>{value}</strong></li>)}
        </ul>

        <h2>Nos engagements</h2>
        <p>
          Nos structures professionnelles de la reconversion sont sélectionnées
          selon des critères spécifiques destinés à assurer le bien-être des
          chevaux réformés.
        </p>
        <ul>
          <li>Qualité des infrastructures, de l’alimentation et des soins.</li>
          <li>Expérience de la reconversion.</li>
          <li>Capacité à vérifier les compétences et la fiabilité des acheteurs.</li>
        </ul>

        <h2>Avantages du référencement Passerelle</h2>
        <ul>
          <li>
            Gage de qualité auprès des propriétaires de chevaux de courses à
            réformer ainsi que des futurs propriétaires.
          </li>
          <li>Visibilité sur nos outils de communication.</li>
          <li>Participation à nos événements.</li>
          <li>
            Soutien individualisé sur le plan juridique, administratif et pour
            la communication.
          </li>
        </ul>

        <h2>Pour les professionnels des courses</h2>
        <p>
          La garantie contractuelle de la meilleure «&nbsp;seconde vie&nbsp;»
          possible pour leur cheval, à l’issue de sa carrière.
        </p>

        <h2>Pour les cavaliers</h2>
        <p>
          L’opportunité d’acheter en toute tranquillité, sous contrat, un cheval
          qui a bénéficié des meilleurs soins et d’un travail adapté à ses
          capacités physiques et mentales.
        </p>

        <blockquote>
          <p>Nous sommes tous responsables de leur avenir&nbsp;!</p>
        </blockquote>
      </Prose>
    </div>
  </section>

  <section class="stats" aria-label="Passerelle en chiffres">
    <div class="wrap stats__grid">
      {
        stats.map((s) => (
          <div class="stat">
            <Icon name={s.icon} class="stat__ico" />
            <p class="stat__value">{s.value}</p>
            <p class="stat__label">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Comment nous agissons</p>
      <h2 class="sec-title">Trois engagements, du premier appel à la fin de leur vie.</h2>
      <ul class="pillars">
        {
          missionPillars.map((p) => (
            <li>
              <span class="badge"><Icon name={p.icon} /></span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="links">
        <a class="tlink" href="#valeurs">
          Nos valeurs
          <Icon name="arrow" />
        </a>
        <a class="tlink" href="/association/equipe">
          L’équipe
          <Icon name="arrow" />
        </a>
        <a class="tlink" href="/protection">
          La protection Passerelle
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <CtaBand
    text="Chaque adhésion et chaque don participe directement à la reconversion d’un cheval."
    accent="Rejoignez-nous."
    label="Adhérer"
    href={links.join}
    external
    note="66 % du montant de votre don est déductible de vos impôts — 60 % pour les entreprises."
  />
</Base>

<style>
  .stats {
    background: var(--forest);
    color: #fff;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .stat {
    text-align: center;
    padding-inline: 1rem;
  }
  .stat + .stat {
    border-left: 1px solid var(--line-light);
  }
  .stat__ico {
    width: 30px;
    height: 30px;
    margin: 0 auto 1.1rem;
    color: var(--sage);
  }
  .stat__value {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .stat__label {
    margin: 0.7rem 0 0;
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  .sec-title {
    max-width: 20ch;
    margin-bottom: 3rem;
  }
  .opening {
    display: grid;
    gap: 0.8rem;
    margin: 0 0 2.8rem;
    padding-bottom: 2.4rem;
    border-bottom: 1px solid var(--line);
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.8rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pillars li {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .pillars h3 {
    margin-bottom: 0.4rem;
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .pillars p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 960px) {
    .stats__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 0;
    }
    .stat:nth-child(3) {
      border-left: 0;
    }
    .pillars {
      grid-template-columns: 1fr;
    }
  }
</style>
