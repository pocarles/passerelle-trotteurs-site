---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import { news } from "../data/site";

const years = [...new Set(news.map((item) => item.date.slice(0, 4)))];
---

<Base
  title="Actualités — Association Passerelle"
  description="Retrouvez toutes les actualités, actions, événements et partenariats de Passerelle en faveur de la reconversion des Trotteurs Français."
>
  <PageHeader
    eyebrow="Journal"
    title="Les actualités"
    accent="de Passerelle."
    lead="Journées #RaceAndCare, salons, partenariats et nouvelles de la reconversion des Trotteurs Français."
    image="/media/expo.jpg"
    imageAlt="Le stand de l’Association Passerelle lors d’un événement"
  />

  <section class="section news">
    <div class="wrap">
      {
        years.map((year) => (
          <section class="year" aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`}>{year}</h2>
            <ul class="news__list">
              {news
                .filter((item) => item.date.startsWith(year))
                .map((item) => (
                  <li>
                    <a href={item.href}>
                      <time datetime={item.date}>{item.dateLabel}</time>
                      <h3>{item.title}</h3>
                      <Icon name="arrowUpRight" class="news__arrow" />
                    </a>
                  </li>
                ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .news {
    background: var(--cream-warm);
  }
  .year + .year {
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }
  .year h2 {
    margin-bottom: 1.5rem;
    color: var(--moss);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
  }
  .news__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .news__list a {
    display: grid;
    grid-template-columns: 170px 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
    transition: padding-inline 0.2s ease;
  }
  .news__list a:hover {
    padding-inline: 0.75rem;
  }
  .news__list time {
    color: var(--moss);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .news__list h3 {
    font-size: 1.28rem;
  }
  .news__arrow {
    width: 17px;
    height: 17px;
    color: var(--ink-faint);
  }

  @media (max-width: 760px) {
    .news__list a {
      grid-template-columns: 1fr auto;
      gap: 0.45rem 1rem;
    }
    .news__list time {
      grid-column: 1 / -1;
    }
  }
</style>
