---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { networkDirectory, site } from "../../data/site";
---

<Base
  title="Annuaire des structures — Association Passerelle"
  description="Retrouvez les coordonnées des structures accréditées du réseau Passerelle."
>
  <PageHeader
    eyebrow="Notre réseau"
    title="Des professionnels engagés"
    accent="partout en France."
    lead="Les structures professionnelles de la reconversion sont sélectionnées selon des critères destinés à assurer le bien-être des chevaux reconvertis."
    image="/media/bond.jpg"
    video="/media/horse-caress.mp4"
    background
  >
    <Fragment slot="actions">
      <div class="network-header-actions">
        <a class="btn btn--ghost-light" href="#annuaire">
          Voir l’annuaire <span class="btn__ico"><Icon name="arrow" /></span>
        </a>
        <a class="btn btn--primary" href="/reseau/carte">
          Voir la carte <span class="btn__ico"><Icon name="map" /></span>
        </a>
      </div>
    </Fragment>
  </PageHeader>

  <section class="section directory-section" id="annuaire">
    <div class="wrap">
      <div class="directory-section__intro">
        <p class="eyebrow">Annuaire</p>
        <h2>{networkDirectory.length} structures accréditées</h2>
        <p class="lead">
          Cliquez sur une structure pour retrouver ses coordonnées et ses liens
          utiles.
        </p>
      </div>

      <div class="directory" data-directory>
        {
          networkDirectory.map((structure) => (
            <details class="directory-card">
              <summary>
                <span class="directory-card__summary-copy">
                  <span class="directory-card__name">{structure.name}</span>
                  <span class="directory-card__department">{structure.department}</span>
                </span>
                <span class="directory-card__toggle" aria-hidden="true"></span>
              </summary>
              <div class="directory-card__content">
                <div class="directory-card__details">
                  <p>
                    <strong>Adresse</strong>
                    {structure.address.map((line) => <span>{line}</span>)}
                  </p>
                  {
                    structure.phones && (
                      <p>
                        <strong>{structure.phones.length > 1 ? "Téléphones" : "Téléphone"}</strong>
                        {structure.phones.map((phone) => (
                          <a href={`tel:${phone.replace(/[^\d+]/g, "")}`}>{phone}</a>
                        ))}
                      </p>
                    )
                  }
                  {
                    structure.email && (
                      <p>
                        <strong>E-mail</strong>
                        <a href={`mailto:${structure.email}`}>{structure.email}</a>
                      </p>
                    )
                  }
                </div>
                {
                  structure.links.length > 0 && (
                    <div class="directory-card__links" aria-label={`Liens de ${structure.name}`}>
                      {structure.links.map((link) => (
                        <a href={link.href} target="_blank" rel="noreferrer">
                          {link.label} <Icon name="arrowUpRight" />
                        </a>
                      ))}
                    </div>
                  )
                }
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    text="Votre structure partage nos valeurs ?"
    accent="Faisons connaissance."
    label="Nous contacter"
    href="/contact"
    note={`Présentez-nous votre activité à ${site.email}.`}
    icon="users"
  />

  <script>
    const directory = document.querySelector<HTMLElement>("[data-directory]");
    const cards = directory?.querySelectorAll<HTMLDetailsElement>(".directory-card");

    cards?.forEach((card) => {
      card.addEventListener("toggle", () => {
        if (!card.open) return;

        cards.forEach((otherCard) => {
          if (otherCard !== card) otherCard.open = false;
        });
      });
    });
  </script>
</Base>

<style>
  .network-header-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .directory-section {
    background: var(--cream);
  }
  .directory-section__intro {
    max-width: none;
    margin-bottom: clamp(2.25rem, 4vw, 3.25rem);
  }
  .directory-section__intro h2 {
    font-size: clamp(2rem, 3.7vw, 3.15rem);
  }
  .directory-section__intro .lead {
    max-width: 48rem;
    margin-bottom: 0;
  }
  .directory {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .directory-card {
    overflow: hidden;
    border-radius: var(--radius);
  }
  .directory-card summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 5.7rem;
    padding: 1.15rem clamp(1.1rem, 3vw, 1.5rem);
    color: var(--forest);
    background: var(--cream-warm);
    border: 1px solid var(--line);
    cursor: pointer;
    list-style: none;
    transition: color 180ms ease, background-color 180ms ease;
  }
  .directory-card summary::-webkit-details-marker {
    display: none;
  }
  .directory-card__summary-copy {
    min-width: 0;
  }
  .directory-card__name,
  .directory-card__department {
    display: block;
  }
  .directory-card__name {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.15;
  }
  .directory-card__department {
    margin-top: 0.3rem;
    color: var(--ink-faint);
    font-size: 0.82rem;
  }
  .directory-card__toggle {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    color: var(--forest);
    background: color-mix(in srgb, var(--sage) 42%, transparent);
    border-radius: 50%;
  }
  .directory-card__toggle::before {
    content: "+";
    font-size: 1.35rem;
    line-height: 1;
  }
  .directory-card[open] summary {
    color: #fff;
    background: var(--forest-deep);
    border-color: var(--forest-deep);
  }
  .directory-card[open] .directory-card__department {
    color: rgba(255, 255, 255, 0.76);
  }
  .directory-card[open] .directory-card__toggle {
    color: var(--forest-deep);
    background: var(--sage);
  }
  .directory-card[open] .directory-card__toggle::before {
    content: "–";
  }
  .directory-card__content {
    display: grid;
    gap: 1.25rem;
    padding: 1.35rem clamp(1.1rem, 3vw, 1.5rem);
    color: var(--ink-soft);
    background: var(--cream);
    border: 1px solid var(--line);
    border-top: 0;
    border-radius: 0 0 var(--radius) var(--radius);
  }
  .directory-card__details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .directory-card__details p {
    min-width: 0;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .directory-card__details strong,
  .directory-card__details span,
  .directory-card__details a {
    display: block;
  }
  .directory-card__details strong {
    margin-bottom: 0.35rem;
    color: var(--forest);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .directory-card__details a {
    color: inherit;
    overflow-wrap: anywhere;
  }
  .directory-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .directory-card__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.7rem;
    color: var(--forest);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .directory-card__links a:hover {
    background: color-mix(in srgb, var(--sage) 30%, transparent);
  }
  .directory-card__links :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
  }

  @media (max-width: 760px) {
    .directory {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .directory-card__details {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
  }
</style>
