---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { networkDirectory, networkMapDepartments, site } from "../../data/site";

const mapDepartments = JSON.stringify(networkMapDepartments);
const directoryId = (name: string) =>
  `structure-${name
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")}`;
const directoryLinks = JSON.stringify(
  Object.fromEntries(networkDirectory.map((structure) => [structure.name, directoryId(structure.name)])),
);
---

<Base
  title="Annuaire des structures — Association Passerelle"
  description="Explorez la carte et retrouvez les coordonnées des structures accréditées du réseau Passerelle."
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
  </Fragment>

  <PageHeader
    eyebrow="Notre réseau"
    title="Des professionnels engagés"
    accent="partout en France."
    lead="Les structures professionnelles de la reconversion sont sélectionnées selon des critères destinés à assurer le bien-être des chevaux reconvertis."
    image="/media/bond.jpg"
    video="/media/horse-caress.mp4"
    background
  >
    <Fragment slot="actions">
      <div class="network-header-actions">
        <a class="btn btn--ghost-light" href="#annuaire">
          Voir l’annuaire <span class="btn__ico"><Icon name="arrow" /></span>
        </a>
        <a class="btn btn--primary" href="#carte">
          Voir la carte <span class="btn__ico"><Icon name="map" /></span>
        </a>
      </div>
    </Fragment>
  </PageHeader>

  <section class="section map-section" id="carte">
    <div class="wrap">
      <div class="map-section__intro">
        <p class="eyebrow">Carte</p>
        <h2>Le réseau Passerelle <span class="accent">près de chez vous.</span></h2>
        <p class="lead">
          Explorez les départements où nos structures accréditées accompagnent
          les Trotteurs vers leur nouvelle vie.
        </p>
      </div>
      <div class="map-layout">
        <aside class="map-layout__aside">
          <span class="map-layout__icon"><Icon name="map" /></span>
          <h3>Un réseau national</h3>
          <p>
            Sélectionnez un repère sur la carte pour découvrir les structures
            présentes dans le département.
          </p>
          <p class="map-layout__note">
            La carte indique les départements renseignés dans l’annuaire.
          </p>
        </aside>
        <div
          class="network-map"
          data-departments={mapDepartments}
          data-directory-links={directoryLinks}
          aria-label="Carte des structures accréditées Passerelle"
        >
          <p class="network-map__loading">Chargement de la carte…</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section directory-section" id="annuaire">
    <div class="wrap">
      <div class="directory-section__intro">
        <p class="eyebrow">Annuaire</p>
        <h2>{networkDirectory.length} structures accréditées</h2>
        <p class="lead">
          Cliquez sur une structure pour retrouver ses coordonnées et ses liens
          utiles.
        </p>
      </div>

      <div class="directory" data-directory>
        {
          networkDirectory.map((structure) => (
            <details class="directory-card" id={directoryId(structure.name)}>
              <summary>
                <span class="directory-card__summary-copy">
                  <span class="directory-card__name">{structure.name}</span>
                  <span class="directory-card__department">{structure.department}</span>
                </span>
                <span class="directory-card__toggle" aria-hidden="true"></span>
              </summary>
              <div class="directory-card__content">
                <div class="directory-card__details">
                  <p>
                    <strong>Adresse</strong>
                    {structure.address.map((line) => <span>{line}</span>)}
                  </p>
                  {
                    structure.phones && (
                      <p>
                        <strong>{structure.phones.length > 1 ? "Téléphones" : "Téléphone"}</strong>
                        {structure.phones.map((phone) => (
                          <a href={`tel:${phone.replace(/[^\d+]/g, "")}`}>{phone}</a>
                        ))}
                      </p>
                    )
                  }
                  {
                    structure.email && (
                      <p>
                        <strong>E-mail</strong>
                        <a href={`mailto:${structure.email}`}>{structure.email}</a>
                      </p>
                    )
                  }
                </div>
                {
                  (structure.links.length > 0 || structure.socials?.length) && (
                    <div class="directory-card__resources">
                      {structure.links.length > 0 && (
                        <div class="directory-card__links" aria-label={`Liens de ${structure.name}`}>
                          {structure.links.map((link) => (
                            <a href={link.href} target="_blank" rel="noreferrer">
                              {link.label} <Icon name="arrowUpRight" />
                            </a>
                          ))}
                        </div>
                      )}
                      {structure.socials?.length && (
                        <div class="directory-card__socials" aria-label={`Réseaux sociaux de ${structure.name}`}>
                          {structure.socials.map((social) => (
                            <a
                              href={social.href}
                              target="_blank"
                              rel="noreferrer"
                              aria-label={`${social.label} de ${structure.name}`}
                              title={`${social.label} de ${structure.name}`}
                            >
                              <Icon name={social.label === "Facebook" ? "facebook" : "instagram"} />
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  )
                }
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    text="Votre structure partage nos valeurs ?"
    accent="Faisons connaissance."
    label="Nous contacter"
    href="/contact"
    note={`Présentez-nous votre activité à ${site.email}.`}
    icon="users"
  />

  <script is:inline src="/vendor/leaflet/leaflet.js"></script>
  <script is:inline src="/js/network-map.js"></script>
  <script>
    const directory = document.querySelector<HTMLElement>("[data-directory]");
    const cards = directory?.querySelectorAll<HTMLDetailsElement>(".directory-card");

    cards?.forEach((card) => {
      card.addEventListener("toggle", () => {
        if (!card.open) return;

        cards.forEach((otherCard) => {
          if (otherCard !== card) otherCard.open = false;
        });
      });
    });

    const openDirectoryCard = (targetId: string) => {
      const card = document.getElementById(targetId);

      if (!(card instanceof HTMLDetailsElement) || !card.classList.contains("directory-card")) {
        return;
      }

      cards?.forEach((otherCard) => {
        if (otherCard !== card) otherCard.open = false;
      });
      card.open = true;
      requestAnimationFrame(() => {
        card.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    };

    const openDirectoryCardFromHash = () => openDirectoryCard(window.location.hash.slice(1));

    window.addEventListener("hashchange", openDirectoryCardFromHash);
    document.addEventListener("network-directory-card-request", (event) => {
      const { id } = (event as CustomEvent<{ id?: string }>).detail ?? {};
      if (id) openDirectoryCard(id);
    });
    openDirectoryCardFromHash();
  </script>
</Base>

<style>
  .network-header-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .map-section {
    padding-top: clamp(2.5rem, 4vw, 3.5rem);
    background: var(--cream-warm);
    border-bottom: 1px solid var(--line);
  }
  .map-section__intro {
    max-width: 62rem;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }
  .map-section__intro .lead {
    max-width: none;
    margin-bottom: 0;
  }
  .map-layout {
    display: grid;
    grid-template-columns: minmax(13rem, 0.38fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: stretch;
  }
  .map-layout__aside {
    padding: clamp(1.4rem, 3vw, 2rem);
    color: #fff;
    background: var(--forest-deep);
    border-radius: var(--radius-lg);
  }
  .map-layout__icon {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    margin-bottom: 1.5rem;
    place-items: center;
    color: var(--forest-deep);
    background: var(--sage);
    border-radius: 50%;
  }
  .map-layout__icon :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }
  .map-layout__aside h3 {
    margin-bottom: 0.75rem;
    color: #fff;
    font-size: clamp(1.35rem, 2vw, 1.65rem);
  }
  .map-layout__aside p {
    margin: 0;
    color: rgba(255, 255, 255, 0.84);
    line-height: 1.55;
  }
  .map-layout__aside .map-layout__note {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    color: var(--sage);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 0.85rem;
  }
  .network-map {
    min-height: clamp(24rem, 48vw, 34rem);
    overflow: hidden;
    background: #eef0e5;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .network-map__loading,
  .network-map__error {
    display: grid;
    min-height: inherit;
    max-width: 32rem;
    padding: 2rem;
    margin: 0 auto;
    place-items: center;
    color: var(--ink-soft);
    text-align: center;
  }
  :global(.network-map .leaflet-popup-content-wrapper) {
    border-radius: 0.85rem;
    box-shadow: 0 0.75rem 1.75rem rgba(23, 58, 39, 0.16);
  }
  :global(.network-map .leaflet-popup-content) {
    margin: 1rem 1.1rem;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  :global(.network-map .leaflet-popup-content strong) {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--forest);
    font-family: var(--serif);
    font-size: 1.15rem;
  }
  :global(.network-map .leaflet-popup-content ul) {
    margin: 0;
    padding-left: 1.1rem;
  }
  :global(.network-map .leaflet-popup-content a) {
    color: var(--forest);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }
  :global(.network-map .leaflet-popup-tip) {
    background: var(--cream);
  }
  .directory-section {
    background: var(--cream);
  }
  .directory-section__intro {
    max-width: none;
    margin-bottom: clamp(2.25rem, 4vw, 3.25rem);
  }
  .directory-section__intro h2 {
    font-size: clamp(2rem, 3.7vw, 3.15rem);
  }
  .directory-section__intro .lead {
    max-width: 48rem;
    margin-bottom: 0;
  }
  .directory {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .directory-card {
    scroll-margin-top: 7.5rem;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .directory-card summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 5.7rem;
    padding: 1.15rem clamp(1.1rem, 3vw, 1.5rem);
    color: var(--forest);
    background: var(--cream-warm);
    border: 1px solid var(--line);
    cursor: pointer;
    list-style: none;
    transition: color 180ms ease, background-color 180ms ease;
  }
  .directory-card summary::-webkit-details-marker {
    display: none;
  }
  .directory-card__summary-copy {
    min-width: 0;
  }
  .directory-card__name,
  .directory-card__department {
    display: block;
  }
  .directory-card__name {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    line-height: 1.15;
  }
  .directory-card__department {
    margin-top: 0.3rem;
    color: var(--ink-faint);
    font-size: 0.82rem;
  }
  .directory-card__toggle {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    color: var(--forest);
    background: color-mix(in srgb, var(--sage) 42%, transparent);
    border-radius: 50%;
  }
  .directory-card__toggle::before {
    content: "+";
    font-size: 1.35rem;
    line-height: 1;
  }
  .directory-card[open] summary {
    color: #fff;
    background: var(--forest-deep);
    border-color: var(--forest-deep);
  }
  .directory-card[open] .directory-card__department {
    color: rgba(255, 255, 255, 0.76);
  }
  .directory-card[open] .directory-card__toggle {
    color: var(--forest-deep);
    background: var(--sage);
  }
  .directory-card[open] .directory-card__toggle::before {
    content: "–";
  }
  .directory-card__content {
    display: grid;
    gap: 1.25rem;
    padding: 1.35rem clamp(1.1rem, 3vw, 1.5rem);
    color: var(--ink-soft);
    background: var(--cream);
    border: 1px solid var(--line);
    border-top: 0;
    border-radius: 0 0 var(--radius) var(--radius);
  }
  .directory-card__details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .directory-card__details p {
    min-width: 0;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .directory-card__details strong,
  .directory-card__details span,
  .directory-card__details a {
    display: block;
  }
  .directory-card__details strong {
    margin-bottom: 0.35rem;
    color: var(--forest);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .directory-card__details a {
    color: inherit;
    overflow-wrap: anywhere;
  }
  .directory-card__resources {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem;
  }
  .directory-card__links,
  .directory-card__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
  .directory-card__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.7rem;
    color: var(--forest);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .directory-card__links a:hover {
    background: color-mix(in srgb, var(--sage) 30%, transparent);
  }
  .directory-card__links :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
  }
  .directory-card__socials a {
    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    place-items: center;
    color: var(--forest);
    border: 1px solid var(--line);
    border-radius: 50%;
    transition: background-color 180ms ease, color 180ms ease;
  }
  .directory-card__socials a:hover {
    color: var(--forest-deep);
    background: color-mix(in srgb, var(--sage) 42%, transparent);
  }
  .directory-card__socials :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  @media (max-width: 760px) {
    .map-layout,
    .directory {
      grid-template-columns: 1fr;
    }
    .map-layout__aside {
      min-height: auto;
    }
  }
  @media (max-width: 520px) {
    .directory-card__details {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
  }
</style>
