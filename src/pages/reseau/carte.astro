---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import CtaBand from "../../components/CtaBand.astro";
import Icon from "../../components/Icon.astro";
import { networkMapDepartments, site } from "../../data/site";

const mapDepartments = JSON.stringify(networkMapDepartments);
---

<Base
  title="Carte des structures — Association Passerelle"
  description="Explorez les départements où les structures accréditées Passerelle accompagnent les Trotteurs vers leur nouvelle vie."
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
  </Fragment>

  <PageHeader
    eyebrow="Notre réseau"
    title="Des professionnels engagés"
    accent="partout en France."
    lead="Les structures professionnelles de la reconversion sont sélectionnées selon des critères destinés à assurer le bien-être des chevaux reconvertis."
    image="/media/bond.jpg"
    video="/media/horse-caress.mp4"
    background
  >
    <Fragment slot="actions">
      <div class="network-header-actions">
        <a class="btn btn--ghost-light" href="/reseau/annuaire#annuaire">
          Voir l’annuaire <span class="btn__ico"><Icon name="arrow" /></span>
        </a>
        <a class="btn btn--primary" href="#carte">
          Voir la carte <span class="btn__ico"><Icon name="map" /></span>
        </a>
      </div>
    </Fragment>
  </PageHeader>

  <section class="section map-section" id="carte">
    <div class="wrap">
      <div class="map-section__intro">
        <p class="eyebrow">Carte</p>
        <h2>Le réseau Passerelle <span class="accent">près de chez vous.</span></h2>
        <p class="lead">
          Explorez les départements où nos structures accréditées accompagnent
          les Trotteurs vers leur nouvelle vie.
        </p>
      </div>
      <div class="map-layout">
        <aside class="map-layout__aside">
          <span class="map-layout__icon"><Icon name="map" /></span>
          <h3>Un réseau national</h3>
          <p>
            Sélectionnez un repère sur la carte pour découvrir les structures
            présentes dans le département.
          </p>
          <p class="map-layout__note">
            La carte indique les départements renseignés dans l’annuaire.
          </p>
        </aside>
        <div
          class="network-map"
          data-departments={mapDepartments}
          aria-label="Carte des structures accréditées Passerelle"
        >
          <p class="network-map__loading">Chargement de la carte…</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    text="Votre structure partage nos valeurs ?"
    accent="Faisons connaissance."
    label="Nous contacter"
    href="/contact"
    note={`Présentez-nous votre activité à ${site.email}.`}
    icon="users"
  />

  <script is:inline src="/vendor/leaflet/leaflet.js"></script>
  <script is:inline src="/js/network-map.js"></script>
</Base>

<style>
  .network-header-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .map-section {
    background: var(--cream-warm);
  }
  .map-section__intro {
    max-width: 62rem;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
  }
  .map-section__intro .lead {
    margin-bottom: 0;
  }
  .map-layout {
    display: grid;
    grid-template-columns: minmax(13rem, 0.38fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: stretch;
  }
  .map-layout__aside {
    padding: clamp(1.4rem, 3vw, 2rem);
    color: #fff;
    background: var(--forest-deep);
    border-radius: var(--radius-lg);
  }
  .map-layout__icon {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    margin-bottom: 1.5rem;
    place-items: center;
    color: var(--forest-deep);
    background: var(--sage);
    border-radius: 50%;
  }
  .map-layout__icon :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }
  .map-layout__aside h3 {
    margin-bottom: 0.75rem;
    color: #fff;
    font-size: clamp(1.35rem, 2vw, 1.65rem);
  }
  .map-layout__aside p {
    margin: 0;
    color: rgba(255, 255, 255, 0.84);
    line-height: 1.55;
  }
  .map-layout__aside .map-layout__note {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    color: var(--sage);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 0.85rem;
  }
  .network-map {
    min-height: clamp(24rem, 48vw, 34rem);
    overflow: hidden;
    background: #eef0e5;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .network-map__loading,
  .network-map__error {
    display: grid;
    min-height: inherit;
    max-width: 32rem;
    padding: 2rem;
    margin: 0 auto;
    place-items: center;
    color: var(--ink-soft);
    text-align: center;
  }
  :global(.network-map .leaflet-popup-content-wrapper) {
    border-radius: 0.85rem;
    box-shadow: 0 0.75rem 1.75rem rgba(23, 58, 39, 0.16);
  }
  :global(.network-map .leaflet-popup-content) {
    margin: 1rem 1.1rem;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  :global(.network-map .leaflet-popup-content strong) {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--forest);
    font-family: var(--serif);
    font-size: 1.15rem;
  }
  :global(.network-map .leaflet-popup-content ul) {
    margin: 0;
    padding-left: 1.1rem;
  }
  :global(.network-map .leaflet-popup-tip) {
    background: var(--cream);
  }

  @media (max-width: 760px) {
    .map-layout {
      grid-template-columns: 1fr;
    }
    .map-layout__aside {
      min-height: auto;
    }
  }
</style>
