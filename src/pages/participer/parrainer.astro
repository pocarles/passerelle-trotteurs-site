---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Prose from "../../components/Prose.astro";
import CtaBand from "../../components/CtaBand.astro";
import { links } from "../../data/site";
---

<Base
  title="Parrainer un trotteur — Association Passerelle"
  description="Un don mensuel finance la pension et les soins des Trotteurs Français accueillis provisoirement par Passerelle."
>
  <PageHeader
    eyebrow="Nous soutenir"
    title="Parrainer un trotteur,"
    accent="mois après mois ou ponctuellement."
    lead="Nous manquons de place, les structures sont saturées. Mais vous pouvez nous aider en faisant un don et en parrainant un cheval pour lui assurer la meilleure seconde vie possible."
    video="/media/parrainer-horse.mp4"
    background
  />

  <section class="section">
    <div class="wrap sponsor__grid">
      <div>
        <p class="eyebrow">Nous avons besoin de vous</p>
        <h2>Aidez-nous <span class="accent">pour les placements provisoires.</span></h2>
      </div>
      <Prose>
        <p>
          Malgré les structures saturées, nous mettons tout en œuvre pour prendre
          en charge chaque demande. Nous avons donc recours à des placements
          provisoires, ce qui implique des frais.
        </p>
        <p>
          Passerelle paie une pension ainsi que des frais annexes —
          maréchalerie, dentisterie, vétérinaire — pour chaque placement
          provisoire.
        </p>
        <p>
          Réalisez un don mensuel pour devenir parrain Passerelle&nbsp;! Le
          simulateur ci-dessous vous permet de visualiser le montant de votre
          réduction d’impôt et le coût réel de votre soutien.
        </p>
        <p>Un reçu fiscal vous sera adressé directement sur la plateforme.</p>
      </Prose>
    </div>

    <div class="wrap tax-diagram" data-tax-simulator aria-labelledby="tax-diagram-title">
      <div class="tax-diagram__heading">
        <p class="eyebrow">En pratique</p>
        <h2 id="tax-diagram-title">Un don de <span data-simulator-amount="heading">10&nbsp;€</span> <span class="accent">par mois.</span></h2>
        <p>Visualisez simplement le coût réel de votre soutien, selon le montant que vous souhaitez donner.</p>
      </div>

      <label class="tax-diagram__start" for="monthly-donation">
        <span class="tax-diagram__symbol" aria-hidden="true">€</span>
        <span>
          <strong>Votre don</strong>
          <span class="tax-diagram__input-wrap">
            <input id="monthly-donation" name="monthly-donation" type="number" min="0" step="0.01" value="10" inputmode="decimal" aria-label="Montant du don en euros" aria-describedby="tax-diagram-note" />
            <small>€ chaque mois ou ponctuellement</small>
          </span>
        </span>
      </label>

      <div class="tax-diagram__connector" aria-hidden="true">↓</div>

      <div class="tax-diagram__cases">
        <article class="tax-case">
          <h3><span aria-hidden="true">✦</span> Professionnel</h3>
          <div class="tax-case__flow">
            <span class="tax-step"><span data-simulator-amount="don-professional">10&nbsp;€</span><small>don</small></span>
            <span class="tax-case__operator" aria-hidden="true">−</span>
            <span class="tax-step tax-step--reduction"><span data-simulator-amount="reduction-professional">6&nbsp;€</span><small>réduction d’impôt</small></span>
            <span class="tax-case__operator" aria-hidden="true">→</span>
            <span class="tax-step tax-step--total"><span data-simulator-amount="total-professional">4&nbsp;€</span><small>coût réel</small></span>
          </div>
        </article>

        <article class="tax-case">
          <h3><span aria-hidden="true">♡</span> Particulier</h3>
          <div class="tax-case__flow">
            <span class="tax-step"><span data-simulator-amount="don-individual">10&nbsp;€</span><small>don</small></span>
            <span class="tax-case__operator" aria-hidden="true">−</span>
            <span class="tax-step tax-step--reduction"><span data-simulator-amount="reduction-individual">6,60&nbsp;€</span><small>réduction d’impôt</small></span>
            <span class="tax-case__operator" aria-hidden="true">→</span>
            <span class="tax-step tax-step--total"><span data-simulator-amount="total-individual">3,40&nbsp;€</span><small>coût réel</small></span>
          </div>
        </article>
      </div>

      <p class="tax-diagram__note" id="tax-diagram-note">Réductions présentées à titre indicatif, sous réserve d’éligibilité et des plafonds en vigueur.</p>
    </div>
  </section>

  <section class="section stories">
    <div class="wrap">
      <p class="eyebrow">Leurs histoires</p>
      <h2>À venir<span class="accent">…</span></h2>
    </div>
  </section>

  <CtaBand
    text="Un soutien régulier pour"
    accent="un avenir plus sûr."
    label="Devenir parrain"
    href={links.sponsor}
    external
    icon="sprout"
  />

  <script is:inline defer src="/js/donation-simulator.js"></script>
</Base>

<style>
  .sponsor__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2.5rem, 7vw, 6rem);
  }
  .stories {
    padding-top: clamp(2rem, 4vw, 3.5rem);
  }
  .tax-diagram {
    display: grid;
    grid-template-columns: minmax(14rem, 0.72fr) minmax(16rem, 1fr);
    align-items: center;
    gap: 0.85rem clamp(2rem, 6vw, 5rem);
    margin-top: clamp(3.5rem, 7vw, 6rem);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--cream-warm);
  }
  .tax-diagram__heading {
    grid-column: 1 / -1;
  }
  .tax-diagram__heading h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.5vw, 2.7rem);
  }
  .tax-diagram__heading > p:last-child {
    max-width: none;
    margin: 1rem 0 0;
    color: var(--muted);
  }
  .tax-diagram__start {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    width: min(42rem, 100%);
    padding: 0.9rem 1.5rem 0.9rem 1rem;
    border-radius: 999px;
    background: var(--forest);
    color: #fff;
    grid-column: 1 / -1;
    justify-self: center;
    cursor: text;
  }
  .tax-diagram__start > span:last-child,
  .tax-step {
    display: inline-flex;
    flex-direction: column;
  }
  .tax-diagram__start > span:last-child {
    display: flex;
    flex: 1;
    flex-direction: row;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
    white-space: nowrap;
  }
  .tax-diagram__start strong {
    white-space: nowrap;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tax-diagram__input-wrap {
    display: flex;
    flex: 1;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem;
    min-width: 0;
    white-space: nowrap;
  }
  .tax-diagram__input-wrap input {
    width: 5.5rem;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }
  .tax-diagram__input-wrap input::-webkit-inner-spin-button,
  .tax-diagram__input-wrap input::-webkit-outer-spin-button {
    margin: 0;
    appearance: none;
  }
  .tax-diagram__input-wrap input[type="number"] {
    appearance: textfield;
  }
  .tax-diagram__start small,
  .tax-step small {
    margin-top: 0.12rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.72);
  }
  .tax-diagram__start small {
    margin-top: 0;
    margin-left: auto;
    white-space: nowrap;
  }
  .tax-diagram__symbol {
    display: grid;
    width: 2.4rem;
    height: 2.4rem;
    place-items: center;
    border-radius: 50%;
    background: var(--sage);
    color: var(--forest-deep);
    font-family: var(--serif);
    font-size: 1.5rem;
  }
  .tax-diagram__connector {
    display: grid;
    grid-column: 1 / -1;
    place-items: center;
    color: var(--moss);
    justify-self: center;
    width: 2rem;
    height: 1.7rem;
    font-size: 1.55rem;
    line-height: 1;
  }
  .tax-diagram__cases {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding-top: 0.25rem;
  }
  .tax-case {
    padding: 1.1rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--cream);
  }
  .tax-case h3 {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1rem;
    color: var(--forest);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .tax-case h3 span {
    color: var(--moss);
    font-size: 1.25rem;
  }
  .tax-case__flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 0.4rem;
  }
  .tax-step {
    min-width: 0;
    padding: 0.8rem 0.35rem;
    border-radius: 0.7rem;
    background: var(--cream-warm);
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2.4vw, 1.65rem);
    line-height: 1;
    text-align: center;
  }
  .tax-step > span {
    display: block;
  }
  .tax-step small {
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.66rem;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: normal;
  }
  .tax-step--reduction {
    background: var(--sage);
  }
  .tax-step--total {
    background: var(--forest);
    color: #fff;
  }
  .tax-step--total small {
    color: rgba(255, 255, 255, 0.72);
  }
  .tax-case__operator {
    color: var(--moss);
    font-size: 1.25rem;
    font-weight: 700;
  }
  .tax-diagram__note {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }
  [data-simulator-amount] {
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 800px) {
    .sponsor__grid {
      grid-template-columns: 1fr;
    }
    .tax-diagram { grid-template-columns: 1fr; }
    .tax-diagram__start,
    .tax-diagram__connector { grid-column: 1; }
    .tax-diagram__start { justify-self: start; }
    .tax-diagram__connector { justify-self: start; }
    .tax-diagram__cases { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .tax-diagram {
      gap: 0.7rem;
      padding: 1.15rem;
    }
    .tax-diagram__heading h2 {
      font-size: clamp(1.65rem, 8vw, 2.15rem);
    }
    .tax-diagram__heading > p:last-child {
      margin-top: 0.75rem;
    }
    .tax-diagram__start {
      width: 100%;
      max-width: 100%;
      justify-self: stretch;
      padding: 0.8rem 0.9rem;
      border-radius: 1.25rem;
    }
    .tax-diagram__start > span:last-child {
      flex-wrap: wrap;
      align-items: center;
      gap: 0.2rem 0.65rem;
      white-space: normal;
    }
    .tax-diagram__input-wrap {
      flex: 1 1 0;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 0.25rem 0.5rem;
      white-space: normal;
    }
    .tax-diagram__input-wrap input {
      flex: 0 0 5rem;
      width: 5rem;
    }
    .tax-diagram__start small {
      flex-basis: 100%;
      margin-left: 0;
      white-space: normal;
      font-size: 0.68rem;
      line-height: 1.3;
    }
    .tax-diagram__symbol {
      width: 2.2rem;
      height: 2.2rem;
    }
    .tax-diagram__connector {
      justify-self: center;
    }
    .tax-case {
      padding: 0.85rem;
    }
    .tax-case__flow {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      grid-template-areas:
        "don operator reduction"
        "total total total";
    }
    .tax-case__flow > .tax-step:first-child {
      grid-area: don;
    }
    .tax-case__flow > .tax-case__operator:nth-child(2) {
      grid-area: operator;
    }
    .tax-case__flow > .tax-step--reduction {
      grid-area: reduction;
    }
    .tax-case__flow > .tax-case__operator:nth-child(4) {
      display: none;
    }
    .tax-case__flow > .tax-step--total {
      grid-area: total;
    }
    .tax-step {
      padding: 0.75rem 0.25rem;
      font-size: clamp(1.15rem, 7vw, 1.4rem);
    }
    .tax-step small {
      font-size: 0.58rem;
    }
  }
</style>
