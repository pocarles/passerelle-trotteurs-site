/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Signal: search=yes, ai-input=yes, ai-train=no, use=reference
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# Keep Cloudflare's public preview and branch deployments out of search results.
# The production domain remains indexable without a launch-day code change.
https://passerelle-trotteurs-site.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.passerelle-trotteurs-site.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# Astro fingerprints these filenames, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=604800
